{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "rifate",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rifate-db",
			"database_id": "a51287a4-2f3d-44d8-815a-b63cdaaac582"
		}
	],
	"vars": {
		"PUBLIC_APP_URL": "https://rifate.mauroviveros.workers.dev"
	},
}
