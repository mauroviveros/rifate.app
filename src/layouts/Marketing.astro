---
import { Brand } from '@/components/brand';

import Base, { type Props as BaseProps } from './Base.astro';

type Props = BaseProps;
---

<Base {...Astro.props}>
  <header
    class="mx-auto flex max-w-wrap items-center justify-between px-5 py-5 sm:px-8"
  >
    <Brand size="lg" href="/" />

    <nav class="flex items-center gap-5 sm:gap-7">
      <a
        href="/#como-funciona"
        class="hidden text-support font-semibold text-muted-foreground hover:text-foreground sm:block"
      >
        Cómo funciona
      </a>
      <a
        href="/#preguntas"
        class="hidden text-support font-semibold text-muted-foreground hover:text-foreground sm:block"
      >
        Preguntas
      </a>
      <a
        href="/ingresar"
        class="inline-flex h-11 items-center rounded-full bg-foreground px-5 text-support font-extrabold text-background transition-colors hover:bg-foreground/90"
      >
        Entrar
      </a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="mx-auto max-w-wrap px-5 pb-11 sm:px-8">
    <div
      class="flex flex-col items-center gap-3 border-t-2 border-border pt-7 sm:flex-row sm:justify-between"
    >
      <Brand size="sm" href="/" />

      <p class="text-support text-subtle-foreground">
        <a href="/terminos" class="hover:text-foreground">Términos</a>
        <span> · </span>
        <a href="/privacidad" class="hover:text-foreground">Privacidad</a>
        <span> · </span>
        <a href="/contacto" class="hover:text-foreground">Contacto</a>
      </p>
    </div>
  </footer>
</Base>
