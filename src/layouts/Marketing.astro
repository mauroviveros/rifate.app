---
import { Brand } from '@/components/brand';

import Base, { type Props as BaseProps } from './Base.astro';

export type Props = BaseProps;

const actual = Astro.url.pathname.replace(/\/$/, '');
const enlaces: { href: string; text: string }[] = [
  { href: '/terminos', text: 'Términos' },
  { href: '/privacidad', text: 'Privacidad' },
  { href: '/contacto', text: 'Contacto' },
];
---

<Base {...Astro.props}>
  <header
    class="mx-auto flex max-w-wrap items-center justify-between px-5 py-5 sm:px-8"
  >
    <Brand size="lg" href="/" />

    <nav class="flex items-center gap-5 sm:gap-7">
      <a
        href="/#como-funciona"
        class="hidden text-support font-semibold text-muted-foreground hover:text-foreground sm:block"
      >
        Cómo funciona
      </a>
      <a
        href="/#preguntas"
        class="hidden text-support font-semibold text-muted-foreground hover:text-foreground sm:block"
      >
        Preguntas
      </a>
      <a
        href="/ingresar"
        class="inline-flex h-11 items-center rounded-full bg-foreground px-5 text-support font-extrabold text-background transition-colors hover:bg-foreground/90"
      >
        Entrar
      </a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="mx-auto max-w-wrap px-5 pb-11 sm:px-8">
    <div
      class="flex flex-col items-center gap-3 border-t-2 border-border pt-7 sm:flex-row sm:justify-between"
    >
      <Brand size="sm" href="/" />

      <p class="flex items-center gap-2 text-support text-subtle-foreground">
        {
          enlaces.map(({ href, text }, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <a
                href={href}
                aria-current={actual === href ? 'page' : undefined}
                class:list={[
                  'hover:text-foreground',
                  'aria-[current]:font-extrabold aria-[current]:text-foreground',
                ]}
              >
                {text}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </footer>
</Base>
