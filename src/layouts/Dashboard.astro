---
import Brand from '@/layouts/components/brand';
import User from '@/layouts/components/User.astro';
import Layout, { type Props as LayoutProps } from '@/layouts/Layout.astro';
interface Props extends LayoutProps {
  heading: string;
  lead?: string;
}

const { title, heading, lead, description, ...props } = Astro.props;
---

<Layout
  title={title}
  description={description}
  class="min-h-dvh trama"
  {...props}
>
  <header
    class="sticky top-0 z-20 h-16 bg-foreground text-background sm:h-19.5"
  >
    <div
      class="mx-auto flex h-full max-w-wrap items-center justify-between gap-4 px-5 sm:px-8"
    >
      <div class="flex min-w-0 items-center gap-4 sm:gap-4.5">
        <Brand href="/panel" size="bar" color="primary" />
      </div>

      <User />
    </div>
  </header>

  <main class="mx-auto max-w-wrap px-5 py-9 sm:px-8 sm:py-10">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
    >
      <hgroup class="min-w-0">
        <h1 class="text-[2.25rem] text-balance sm:text-display">
          {heading}
        </h1>
        {
          lead && (
            <p class="mt-2 line-clamp-2 text-support text-muted-foreground sm:text-body">
              {lead}
            </p>
          )
        }
      </hgroup>

      {
        Astro.slots.has('actions') && (
          <div class="shrink-0">
            <slot name="actions" />
          </div>
        )
      }
    </div>

    <slot />
  </main>
</Layout>
