---
import { Icon } from 'astro-icon/components';

import Marketing, { type Props as MarketingProps } from './Marketing.astro';

interface Props extends MarketingProps {
  lead: string;
  updated?: string;
}

const { title, description, lead, updated } = Astro.props;
const updatedDate = updated
  ? new Date(updated).toLocaleDateString('es-AR', {
      dateStyle: 'long',
      timeZone: 'UTC',
    })
  : undefined;
---

<Marketing title={`${title} · rifate.app`} description={description}>
  <div class="mx-auto max-w-180 px-5 py-12 sm:px-8 sm:py-16">
    <header class="flex flex-col gap-4.5">
      <h1
        class="text-[2.75rem] leading-[1.02] tracking-[-0.028em] sm:text-[4.125rem]"
      >
        {title}
      </h1>

      <p
        class="max-w-156 text-xl leading-snug text-pretty text-muted-foreground sm:text-[1.375rem]"
      >
        {lead}
      </p>

      {
        updatedDate && (
          <p>
            <span class="inline-flex items-center gap-2 rounded-sm border-2 border-dashed border-input px-3.5 py-2 text-label font-bold text-subtle-foreground">
              <Icon name="lucide:clock" class="size-4.25" aria-hidden="true" />
              Última actualización: {updatedDate}
            </span>
          </p>
        )
      }
    </header>

    <div class="my-9 perforado"></div>

    <div class="flex flex-col gap-11">
      <slot />
    </div>
  </div>
</Marketing>
