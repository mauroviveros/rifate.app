---
import '@/styles/global.css';

import type { HTMLAttributes } from 'astro/types';
import { Font } from 'astro:assets';

export interface Props extends HTMLAttributes<'body'> {
  title: string;
  description?: string;
}

const { title, description, class: className, ...props } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <Font cssVariable="--googlefont-bricolage" />
    <Font cssVariable="--googlefont-figtree" preload />
  </head>
  <body class={className} {...props}>
    <slot />
  </body>
</html>
