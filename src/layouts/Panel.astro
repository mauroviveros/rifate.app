---
import MenuSesion from '@/components/MenuSesion.astro';
import Base from '@/layouts/Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} · rifate.app`}>
  <header class="border-b-2 bg-paper-light">
    <div
      class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4"
    >
      <a
        href="/dashboard/raffle"
        class="font-display text-title font-extrabold tracking-tight"
      >
        rifate<span class="text-vermilion">.app</span>
      </a>

      <MenuSesion />
    </div>
  </header>

  {
    /* pb-28 deja lugar a la barra fija de la regla 3, que llega con la grilla. */
  }
  <main class="mx-auto w-full max-w-5xl px-5 py-8 pb-28">
    <slot />
  </main>
</Base>
