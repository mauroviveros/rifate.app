---
import MenuPrimitive from "@starwind-ui/astro/menu";
import type { HTMLAttributes } from "astro/types";
import { dropdownItem } from "./variants";

type Props = HTMLAttributes<"div"> & {
  inset?: boolean;
  disabled?: boolean;
  variant?: "default" | "destructive";
};

const {
  class: className,
  inset = false,
  disabled = false,
  variant = "default",
  ...rest
} = Astro.props;
---

<MenuPrimitive.Item
  class={dropdownItem({ inset, disabled, variant, class: className })}
  disabled={disabled}
  {...rest}
  data-slot="dropdown-item"
>
  <slot />
</MenuPrimitive.Item>
