---
/**
 * Un texto con un botón que lo copia al portapapeles.
 *
 * No sabe nada de rifas: recibe qué copiar y qué mostrar. El `<script>` toma
 * TODAS las instancias del documento, así que poner dos en una pantalla
 * funciona sin configurar nada.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** El texto que se copia. */
  value: string;
  /** Lo que se muestra; por defecto, el `value`. */
  label?: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
const shown = label ?? value;
---

<div
  class:list={[
    'flex min-w-0 items-center gap-2 rounded-lg border-2 border-border bg-card py-1 pr-1 pl-3',
    className,
  ]}
  data-copy-link
  data-value={value}
>
  <span
    class="min-w-0 flex-1 truncate text-label font-semibold text-muted-foreground"
  >
    {shown}
  </span>

  <button
    type="button"
    class="group/copy flex shrink-0 items-center gap-1.5 rounded-md bg-foreground px-3 py-2 text-label font-extrabold text-background transition-colors hover:bg-foreground/90 focus-visible:ring-3 focus-visible:ring-outline/50"
    data-copy-button
  >
    <Icon
      name="lucide:copy"
      class="size-4 group-data-copied/copy:hidden"
      aria-hidden="true"
    />
    <Icon
      name="lucide:check"
      class="hidden size-4 group-data-copied/copy:block"
      aria-hidden="true"
    />
    <span data-copy-label>Copiar</span>
  </button>

  {/* El cambio de ícono es visual: esto es lo que se lo cuenta a un lector. */}
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  for (const $box of document.querySelectorAll<HTMLDivElement>(
    '[data-copy-link]',
  )) {
    const $button = $box.querySelector<HTMLButtonElement>('[data-copy-button]');
    const $label = $box.querySelector<HTMLSpanElement>('[data-copy-label]');
    const $status = $box.querySelector<HTMLSpanElement>('[data-copy-status]');
    const value = $box.dataset.value ?? '';

    if (!$button) continue;

    $button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value);

        $button.dataset.copied = '';
        if ($label) $label.textContent = '¡Copiado!';
        if ($status) $status.textContent = 'Link copiado';

        setTimeout(() => {
          delete $button.dataset.copied;
          if ($label) $label.textContent = 'Copiar';
          if ($status) $status.textContent = '';
        }, 2000);
      } catch {
        /* Sin permiso de portapapeles, o en un contexto no seguro. El link
           está a la vista igual: se puede seleccionar y copiar a mano. */
        if ($status) $status.textContent = 'No se pudo copiar';
      }
    });
  }
</script>
