---
import { Tile } from '@/components/ui/tile';

interface Props {
  number: number | string;
  title: string;
}

const { number, title } = Astro.props;
---

<section class="flex flex-col gap-4">
  <div class="flex items-center gap-3.5">
    <Tile size="sm">{number}</Tile>
    <h2>{title}</h2>
  </div>

  <div
    class:list={[
      'flex flex-col gap-3',
      '[&_p]:text-body [&_p]:leading-relaxed [&_p]:text-pretty [&_p]:text-muted-foreground',
      '[&_a]:font-bold [&_a]:text-primary [&_a]:hover:text-primary/80',
      '[&_strong]:font-extrabold [&_strong]:text-foreground',
      '[&_ul]:flex [&_ul]:flex-col [&_ul]:gap-3',
      '[&_li]:relative [&_li]:pl-6 [&_li]:text-body [&_li]:leading-relaxed [&_li]:text-muted-foreground',
      '[&_li]:before:absolute [&_li]:before:top-[0.68em] [&_li]:before:left-0 [&_li]:before:size-2.25 [&_li]:before:rounded-[3px] [&_li]:before:bg-primary [&_li]:before:content-[""]',
    ]}
  >
    <slot />
  </div>
</section>
