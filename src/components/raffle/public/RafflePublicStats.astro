---
import RaffleStats from '@ui/Stats.astro';

import { formatCurrency, formatDate } from '@/lib/formatters';
import type { Stats } from '@/types';

interface Props {
  drawDate: string;
  pricePerNumber: number;
  availableNumbers: number;
  totalNumbers: number;
}
const { drawDate, pricePerNumber, availableNumbers, totalNumbers } =
  Astro.props;

const STATS: Stats[] = [
  {
    name: 'Disponibles',
    value: `${availableNumbers}/${totalNumbers}`,
    icon: 'lucide:check',
  },
  {
    name: 'Precio por número',
    value: `${formatCurrency(pricePerNumber)}`,
    icon: 'lucide:tag',
    highlight: 'accent',
  },
  {
    name: 'Fecha del sorteo',
    value: `${formatDate(new Date(drawDate), { dateStyle: 'long' })}`,
    icon: 'lucide:calendar',
    className: 'row-start-1 col-start-2 lg:row-auto lg:col-auto',
  },
];
---

<article class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-3">
  {
    STATS.map((props, i) => (
      <RaffleStats
        class:list={[
          props.highlight === 'accent' ? 'col-span-2 lg:col-span-1' : '',
          props.className ?? '',
        ]}
        {...props}
      />
    ))
  }
</article>
