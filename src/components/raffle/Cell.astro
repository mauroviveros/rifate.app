---
/**
 * Un número del talonario, de sólo lectura: mirar, no tocar.
 *
 * Vive fuera de `panel/` porque la usan dos lados: la grilla del panel cuando
 * no se puede anotar (el borrador y la rifa cerrada) y la página pública
 * `/r/[slug]`. La versión tildable es `SellCell`, y ésa sí es del panel: es la
 * única pantalla donde se anota una venta.
 *
 * El estado se pinta con `data-taken` y no con clases elegidas acá, para que
 * la página pública lo pueda cambiar en vivo prendiendo y apagando un atributo
 * (ver su `<script>`). Si el tachado dependiera de clases armadas en el
 * frontmatter, el cliente tendría que saber cuáles son y repetirlas.
 */
import type { NumberStatus } from '@/types/raffle';
import { numberLabel } from '@/utils/frontmatter/numbers';
import { isTaken } from '@/utils/live';

interface Props {
  status: NumberStatus;
  value: number;
  /** Ancho de padding de la etiqueta (de `numberWidth`). */
  width: number;
  /**
   * El número que salió en el sorteo. Le gana a `data-taken`: no se tacha,
   * se marca en tinta, que es lo que se busca primero en una rifa cerrada.
   * Puede ser un número que no se vendió, y se marca igual: es el que salió.
   */
  winner?: boolean;
}

const { status, value, width, winner = false } = Astro.props;
---

<div
  class:list={[
    'group flex aspect-square items-center justify-center',
    'rounded-md border-2 text-support font-extrabold select-none',
    'border-input bg-card text-foreground',
    'data-taken:border-border data-taken:bg-muted data-taken:tachado data-taken:text-disabled-foreground',
    'data-winner:border-foreground data-winner:bg-foreground data-winner:text-warning',
  ]}
  data-number={value}
  data-taken={!winner && isTaken(status) ? '' : undefined}
  data-winner={winner ? '' : undefined}
>
  <span data-numero>{numberLabel(value, width)}</span>
  <span class="sr-only hidden group-data-taken:inline"> · vendido</span>
  <span class="sr-only hidden group-data-winner:inline"> · ganador</span>
</div>
