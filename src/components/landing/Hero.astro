---
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';

const numeros = Array.from({ length: 40 }, (_, i) => i + 1);
const vendidos = new Set([1, 3, 7, 10, 12, 16, 19, 21, 24, 27, 32, 35, 39]);
const elegidos = new Set([5, 13, 28]);

const ventajas = [
  'Entrás con tu cuenta de Google',
  'Tus compradores no se registran',
];
---

<section
  class:list={[
    'mx-auto max-w-wrap px-5 pt-10 pb-20 sm:px-8',
    'lg:grid lg:grid-cols-[1fr_minmax(0,460px)] lg:items-center lg:gap-16 lg:pt-16',
  ]}
>
  <div>
    <span
      class:list={[
        'bg-foreground text-background',
        'text-[0.8125rem] tracking-[0.14em]',
        'inline-block rounded-full px-3.5 py-2 font-extrabold',
      ]}
    >
      HECHO PARA RIFAS DE BARRIO
    </span>

    <h1
      class:list={[
        'mt-6 text-balance',
        'text-[clamp(2.75rem,6vw,4.875rem)]',
        'leading-[1.03] tracking-[-0.028em]',
      ]}
    >
      Vendé tu rifa por WhatsApp, <span class="text-primary">sin cuaderno.</span
      >
    </h1>

    <p
      class="mt-6 max-w-136 text-xl leading-[1.45] text-pretty text-muted-foreground sm:text-[1.375rem]"
    >
      Armá la rifa una vez, mandá el link y mirá en vivo qué números se
      vendieron. Nada de anotar en papel ni preguntar quién compró qué.
    </p>

    <div class="mt-9 flex flex-col gap-3.5 sm:flex-row">
      <Button href="/panel" variant="primary" size="lg">
        Crear mi rifa gratis
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </Button>

      <Button href="#como-funciona" variant="outline" size="lg">
        Ver una rifa de ejemplo
      </Button>
    </div>

    <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:gap-6">
      {
        ventajas.map((ventaja) => (
          <span class="inline-flex items-center gap-2 text-support font-semibold text-muted-foreground">
            <Icon
              name="lucide:check"
              class="size-5 shrink-0 text-success"
              aria-hidden="true"
            />
            {ventaja}
          </span>
        ))
      }
    </div>
  </div>

  <div
    class:list={[
      'relative mt-14 lg:mt-0',
      'before:absolute before:-z-10 before:rounded-3xl before:bg-trama',
      'before:top-5 before:-right-3 before:-bottom-3 before:left-5',
    ]}
  >
    <div
      class="rounded-3xl border-2 border-border bg-card p-5 shadow-papel sm:p-6"
    >
      <div class="mb-1 flex items-center justify-between gap-3">
        <span class="font-display text-xl font-extrabold tracking-tight">
          Rifa del Club Estrella
        </span>
        <span
          class:list={[
            'bg-success/12 text-label font-extrabold text-success',
            'shrink-0 rounded-full px-2.5 py-1',
          ]}
        >
          En venta
        </span>
      </div>

      <p class="mb-5 text-support text-subtle-foreground">
        100 números · $2.500 cada uno
      </p>

      <ul class="grid grid-cols-10 gap-1.5" aria-hidden="true">
        {
          numeros.map((n) => (
            <li
              data-numero
              class:list={[
                'grid aspect-square place-items-center',
                'rounded-[10px] border-2 text-[13px] font-extrabold',
                elegidos.has(n)
                  ? 'border-foreground bg-foreground text-background'
                  : vendidos.has(n)
                    ? 'border-input bg-muted tachado text-disabled-foreground'
                    : 'border-input bg-card text-foreground',
              ]}
            >
              {String(n).padStart(2, '0')}
            </li>
          ))
        }
      </ul>

      <div class="my-4 perforado"></div>

      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-label font-semibold text-subtle-foreground">
            Recaudado hasta hoy
          </p>
          <p
            class="font-display text-3xl font-extrabold tracking-tight text-success"
          >
            $67.500
          </p>
        </div>

        <span
          class:list={[
            'inline-flex shrink-0 items-center gap-2 rounded-[15px] px-4 py-3',
            'bg-foreground text-support font-extrabold text-background',
          ]}
        >
          <Icon name="lucide:share-2" class="size-5" aria-hidden="true" />
          <span class="hidden sm:inline">Compartir link</span>
          <span class="sm:hidden">Compartir</span>
        </span>
      </div>
    </div>
  </div>
</section>
