---
import { Icon } from 'astro-icon/components';
---

<section class="mx-auto max-w-wrap px-5 pb-20 sm:px-8">
  <div
    class:list={[
      'flex flex-col items-start gap-8',
      'rounded-3xl p-9 sm:p-14',
      'bg-primary text-primary-foreground',
      'lg:flex-row lg:items-center lg:justify-between',
    ]}
  >
    <div>
      <h2 class="text-[2rem] leading-[1.05] text-balance sm:text-[2.875rem]">
        Tu próxima rifa, lista en dos minutos.
      </h2>
      <p class="mt-3 text-xl text-primary-foreground/85">
        Entrás con Google, cargás cinco datos y ya tenés el link para mandar.
      </p>
    </div>

    <a
      href="/panel"
      class:list={[
        'inline-flex shrink-0 items-center justify-center gap-2.5',
        'h-button-lg rounded-lg px-8 transition-transform hover:-translate-y-0.5',
        'bg-card text-body font-extrabold tracking-tight text-foreground',
        'focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-card',
      ]}
    >
      Crear mi rifa gratis
      <Icon name="lucide:arrow-right" class="size-6" aria-hidden="true" />
    </a>
  </div>
</section>
