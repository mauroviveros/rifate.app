---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';

import { Input } from '@/components/starwind/input';
import { Textarea } from '@/components/starwind/textarea';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  /** El `name` del control. Es también la raíz de sus ids. */
  name: string;
  label: string;
  hint?: string;
  optional?: boolean;
  /** El `fields[name]` de un `ActionInputError`. Se muestra sólo el primero. */
  errors?: string[];
  value?: string;
  /** `textarea` dibuja el campo alto del artboard (108px). */
  type?: 'text' | 'number' | 'date' | 'tel' | 'textarea';
  inputmode?: 'numeric' | 'decimal' | 'tel';
  placeholder?: string;
  /** Número para `type="number"`, fecha ISO (`YYYY-MM-DD`) para `type="date"`. */
  min?: number | string;
  /** Número para `type="number"`, fecha ISO (`YYYY-MM-DD`) para `type="date"`. */
  max?: number | string;
  /** Número para `type="number"`. */
  step?: number;
  /** Prefijo pegado adentro del campo, como el `$` del precio. */
  prefix?: string;
  controlHidden?: boolean;
  /**
   * Campo bloqueado: se ve pero no se puede tocar ni enfocar. Lo maneja el
   * `disabled` de `Input`/`Textarea` de starwind (`cursor-not-allowed`, apagado).
   * Un `disabled` NO se envía: el valor real viaja por un campo oculto aparte.
   */
  disabled?: boolean;
  /** Nota bajo el control, para explicar por qué está bloqueado (regla 7). */
  note?: string;
  class?: string;
}

const {
  name,
  label,
  hint,
  optional = false,
  errors,
  value = '',
  type = 'text',
  inputmode,
  placeholder,
  min,
  max,
  step,
  prefix,
  controlHidden = false,
  disabled = false,
  note,
  class: className,
  ...rest
} = Astro.props;

const error = errors?.[0];
const required = !optional;
const describedBy =
  [hint && `${name}-hint`, error && `${name}-error`]
    .filter(Boolean)
    .join(' ') || undefined;

/**
 * El look de Talonario (papel, borde de 2px, 60px de alto). Va por `class`, que
 * `Input`/`Textarea` mergean por encima de su base de starwind.
 */
const FIELD_BASE =
  'w-full rounded-[0.9375rem] border-2 border-input bg-white px-4.5 ' +
  'text-[1.1875rem] font-semibold text-foreground ' +
  'placeholder:font-normal placeholder:text-disabled-foreground ' +
  'aria-invalid:border-error';

const inputClass = [FIELD_BASE, 'h-field', prefix && 'pl-9.5']
  .filter(Boolean)
  .join(' ');
const textareaClass = `${FIELD_BASE} h-27 py-4 leading-normal`;
---

<div data-field={name} class:list={className} {...rest}>
  <label for={name} class="block text-[1.1875rem] font-extrabold">
    {label}{
      optional && (
        <span class="ml-1.5 text-support font-medium text-subtle-foreground">
          (opcional)
        </span>
      )
    }
  </label>

  {
    hint && (
      <p id={`${name}-hint`} class="mt-0.5 text-support text-subtle-foreground">
        {hint}
      </p>
    )
  }

  <div class="relative mt-2.5" data-field-control hidden={controlHidden}>
    {
      type === 'textarea' ? (
        <Textarea
          id={name}
          name={name}
          rows={3}
          required={required}
          disabled={disabled}
          class={textareaClass}
          placeholder={placeholder}
          aria-describedby={describedBy}
          aria-invalid={error ? 'true' : undefined}
          value={value}
        />
      ) : (
        <>
          {prefix && (
            <span
              class="pointer-events-none absolute inset-y-0 left-4.5 z-10 flex items-center text-[1.1875rem] font-semibold text-subtle-foreground"
              aria-hidden="true"
            >
              {prefix}
            </span>
          )}
          <Input
            id={name}
            name={name}
            type={type}
            value={value}
            required={required}
            disabled={disabled}
            class={inputClass}
            inputmode={inputmode}
            placeholder={placeholder}
            min={min}
            max={max}
            step={step}
            aria-describedby={describedBy}
            aria-invalid={error ? 'true' : undefined}
          />
        </>
      )
    }
  </div>

  {note && <p class="mt-2 text-support text-subtle-foreground">{note}</p>}

  {
    error && (
      <p
        id={`${name}-error`}
        class="mt-2 flex items-start gap-2 text-support font-bold text-error"
        role="alert"
      >
        <Icon name="lucide:circle-alert" class="mt-0.5 size-5 shrink-0" />
        <span>{error}</span>
      </p>
    )
  }
</div>
