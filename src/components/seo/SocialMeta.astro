---
// Meta tags de SEO y redes (canonical + Open Graph + Twitter Card).
// Componente reutilizable: cada página le pasa su título, descripción e imagen.
interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta o relativa a la raíz de la imagen social. */
  image?: string;
  /** Ruta canónica de esta página (por defecto, la URL actual). */
  path?: string;
  type?: 'website' | 'article';
}

const { title, description, image, path, type = 'website' } = Astro.props;

// Resolvemos contra Astro.site para emitir siempre URLs absolutas, que es lo
// que requieren los crawlers de OG/Twitter.
const canonical = new URL(path ?? Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = image
  ? new URL(image, Astro.site ?? Astro.url).toString()
  : undefined;
const fullTitle = `${title} | Rifate.app`;
---

<link rel="canonical" href={canonical.toString()} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Rifate.app" />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical.toString()} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:width" content="1200" />}
{imageURL && <meta property="og:image:height" content="630" />}

<meta
  name="twitter:card"
  content={imageURL ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{imageURL && <meta name="twitter:image" content={imageURL} />}
