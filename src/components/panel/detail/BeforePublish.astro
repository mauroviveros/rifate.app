---
import { Icon } from 'astro-icon/components';

import Field from '@/components/form/Field.astro';
import { Button } from '@/components/starwind/button';
import { button } from '@/components/starwind/button/variants';
import type { OwnerRaffle } from '@/types/raffle';
import {
  beforePublishItems,
  pendingBeforePublish,
} from '@/utils/frontmatter/detail';

interface Props {
  raffle: OwnerRaffle;
  /** `actions.raffle.publish` — «Guardar y publicar». */
  publishAction: string;
  /** `actions.raffle.setPhone` — «Guardar sin publicar todavía». */
  setPhoneAction: string;
  /** Error de campo de `contactPhone`, tras un intento fallido. */
  phoneErrors?: string[];
  /** Error de dominio (no de campo) de publish / setPhone. */
  phoneError?: string | null;
  /** Lo que se tipeó, para no perderlo tras un error. */
  phoneValue?: string;
}

const {
  raffle,
  publishAction,
  setPhoneAction,
  phoneErrors,
  phoneError = null,
  phoneValue = '',
} = Astro.props;

const needsPhone = raffle.contactPhone === null;
const pending = pendingBeforePublish(raffle);

// Con teléfono, los cuatro ítems van tildados. Sin teléfono, el renglón del
// teléfono deja de ser un ítem y pasa a ser el campo de abajo.
const items = needsPhone
  ? beforePublishItems(raffle).filter((i) => i.done)
  : beforePublishItems(raffle);

const lead =
  pending === 0
    ? 'Ya está todo.'
    : pending === 1
      ? 'Falta una sola cosa.'
      : `Faltan ${pending} cosas.`;

const alertBox =
  'flex items-start gap-2 rounded-lg bg-primary/8 p-3 text-support font-bold text-primary';
---

<div
  id="antes-de-publicar"
  class:list={[
    'rounded-xl bg-card p-6 ring-2',
    needsPhone ? 'ring-primary/55' : 'ring-border',
  ]}
>
  <h2 class="text-[1.25rem]">Antes de publicar</h2>
  <p class="mt-0.5 text-support text-subtle-foreground">{lead}</p>

  <ul class="mt-3">
    {
      items.map((item) => (
        <li class="flex items-start gap-3 border-b-2 border-border/60 py-3 last:border-b-0">
          <span
            class="mt-0.5 flex size-6.5 shrink-0 items-center justify-center rounded-lg bg-success/15 text-success"
            aria-hidden="true"
          >
            <Icon name="lucide:check" class="size-3.5" />
          </span>
          <span class="text-body font-bold">
            {item.label}
            <span class="sr-only"> · listo</span>
          </span>
        </li>
      ))
    }
  </ul>

  {
    needsPhone ? (
      <form method="POST" novalidate class="mt-4">
        <input type="hidden" name="id" value={raffle.id} />

        <Field
          name="contactPhone"
          label="Un teléfono de contacto"
          hint="Es el que va a ver la gente para escribirte por WhatsApp."
          type="tel"
          inputmode="tel"
          placeholder="11 2345-6789"
          value={phoneValue}
          errors={phoneErrors}
        />

        <p class="mt-2 text-label text-subtle-foreground">
          Se muestra en la página de la rifa. Tu mail no lo ve nadie.
        </p>

        {phoneError && (
          <p class:list={['mt-3', alertBox]} role="alert">
            <Icon name="lucide:circle-alert" class="mt-0.5 size-5 shrink-0" />
            <span>{phoneError}</span>
          </p>
        )}

        <Button
          type="submit"
          formaction={publishAction}
          variant="primary"
          size="md"
          class="mt-4 w-full"
        >
          <Icon name="lucide:check" aria-hidden="true" />
          Guardar y publicar la rifa
        </Button>

        <button
          type="submit"
          formaction={setPhoneAction}
          class="mt-3 block w-full text-center text-support font-bold text-subtle-foreground transition-colors hover:text-foreground"
        >
          Guardar sin publicar todavía
        </button>
      </form>
    ) : (
      <div class="mt-4">
        {phoneError ? (
          <p class:list={['mb-3', alertBox]} role="alert">
            <Icon name="lucide:circle-alert" class="mt-0.5 size-5 shrink-0" />
            <span>{phoneError}</span>
          </p>
        ) : (
          <p class="text-support text-subtle-foreground">
            Ya está todo. Publicá con el botón de arriba cuando quieras.
          </p>
        )}
      </div>
    )
  }
</div>

{
  /* La barra fija de mobile, con la misma condición `needsPhone` que decide el
     formulario de arriba. Vive en este archivo porque su único trabajo es
     llevar a ese campo: separada, tenía que buscar `#antes-de-publicar` y
     `[name="contactPhone"]` en el documento, adivinando el markup de acá. El
     espaciador que le reserva el alto lo pone la página. */
}
{
  needsPhone && (
    <div
      class:list={[
        'fixed inset-x-0 bottom-0 z-20 lg:hidden',
        'border-t-2 border-border bg-card px-5 pt-3 pb-4',
        'shadow-[0_-12px_28px_-16px_rgba(23,24,28,0.5)]',
      ]}
    >
      <p class="mb-2.5 text-center text-support font-bold text-subtle-foreground">
        Falta el teléfono para poder publicar
      </p>
      <button
        type="button"
        class:list={[button({ variant: 'primary', size: 'md' }), 'w-full']}
        data-goto-phone
      >
        <Icon name="lucide:phone" aria-hidden="true" />
        Cargar el teléfono
      </button>
    </div>
  )
}

<script>
  const card = document.querySelector<HTMLElement>('#antes-de-publicar');
  const input = card?.querySelector<HTMLInputElement>('[name="contactPhone"]');

  /* Tras un error del server —de campo o de dominio, como «Cargá un teléfono
     de contacto antes de publicar.»— llevar la vista al campo del teléfono y
     enfocarlo. Mismo gesto que el alta y el panel de venta. */
  const flagged =
    card?.querySelector<HTMLElement>('[aria-invalid="true"]') ??
    card?.querySelector<HTMLElement>('[role="alert"]');

  if (card && flagged) {
    const focusError = () => {
      (input ?? flagged).scrollIntoView({
        block: 'center',
        behavior: 'smooth',
      });
      input?.focus({ preventScroll: true });
    };
    if (document.fonts) document.fonts.ready.then(focusError);
    else focusError();
  }

  /* La barra fija de mobile lleva al mismo campo: es el mismo gesto, sin el
     error de por medio. */
  document
    .querySelector<HTMLButtonElement>('[data-goto-phone]')
    ?.addEventListener('click', () => {
      card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      input?.focus({ preventScroll: true });
    });
</script>
