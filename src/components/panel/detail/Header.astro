---
import { Icon } from 'astro-icon/components';

import CopyLink from '@/components/panel/CopyLink.astro';
import { button } from '@/components/starwind/button/variants';
import type { OwnerRaffle } from '@/types/raffle';
import { shortDate } from '@/utils/format';
import { publishHint } from '@/utils/frontmatter/detail';

interface Props {
  raffle: OwnerRaffle;
  publishAction: string;
  /** El link público completo (`https://rifate.app/r/slug`). */
  publicUrl: string;
}

const { raffle, publishAction, publicUrl } = Astro.props;

const isDraft = raffle.status === 'DRAFT';
const linkVisible = raffle.status === 'PUBLISHED' || raffle.status === 'CLOSED';
const hint = publishHint(raffle);
---

<header>
  <h1 class="text-[2.25rem] text-balance sm:text-display">{raffle.title}</h1>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
    <span
      class="flex items-center gap-2 text-label font-semibold text-muted-foreground"
    >
      <Icon
        name="lucide:calendar"
        class="size-4.5 shrink-0 text-subtle-foreground"
        aria-hidden="true"
      />
      Sortea el <time datetime={raffle.drawDate}>
        {shortDate(raffle.drawDate)}
      </time>
    </span>

    {
      linkVisible && (
        <CopyLink
          value={publicUrl}
          label={publicUrl.replace(/^https?:\/\//, '')}
          class="max-w-full"
        />
      )
    }

    {
      isDraft && (
        <form method="POST" action={publishAction} class="contents">
          <input type="hidden" name="id" value={raffle.id} />
          <button
            type="submit"
            disabled={hint !== null}
            class={button({
              variant: 'primary',
              size: 'md',
              class: 'w-full sm:w-auto',
            })}
          >
            {hint ?? 'Publicar la rifa'}
          </button>
        </form>
      )
    }
  </div>
</header>
