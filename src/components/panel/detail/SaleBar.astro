---
import { button } from '@/components/starwind/button/variants';
---

{
  /* Reserva el alto de la barra fija para que nada quede debajo. Va hasta `lg`,
    que es cuando el panel `Sale` pasa a sticky al costado y ya no hace falta. */
}
<div class="h-20 lg:hidden" aria-hidden="true"></div>

{
  /* Arranca oculto (clase `hidden`); el script de `Sale` la togglea junto con
    `flex` según la selección. `lg:hidden` la saca cuando `Sale` va sticky. */
}
<div
  class:list={[
    'fixed inset-x-0 bottom-0 z-20 hidden lg:hidden',
    'items-center gap-3 border-t-2 border-border bg-card px-5 pt-3 pb-4',
    'shadow-[0_-12px_28px_-16px_rgba(23,24,28,0.5)]',
  ]}
  data-salebar
>
  <p
    class="min-w-0 flex-1 truncate text-support font-bold text-subtle-foreground"
    data-salebar-text
    data-numero
  >
  </p>

  <button
    type="button"
    class:list={[button({ variant: 'success', size: 'md' }), 'shrink-0']}
    data-salebar-go
  >
    Cargar la venta
  </button>
</div>
