---
import { button } from '@/components/starwind/button/variants';

interface Props {
  /** El `id` del <form> de venta al que lleva el botón. */
  formId: string;
}

const { formId } = Astro.props;
---

{
  /* Reserva el alto de la barra fija para que los compradores no queden debajo. */
}
<div class="h-20 sm:hidden" aria-hidden="true"></div>

<div
  class:list={[
    'fixed inset-x-0 bottom-0 z-20 sm:hidden',
    'flex items-center gap-3 border-t-2 border-border bg-card px-5 pt-3 pb-4',
    'shadow-[0_-12px_28px_-16px_rgba(23,24,28,0.5)]',
  ]}
  data-salebar
  data-form={formId}
  hidden
>
  <p
    class="min-w-0 flex-1 truncate text-support font-bold text-subtle-foreground"
    data-salebar-text
    data-numero
  >
  </p>

  <button
    type="button"
    class:list={[button({ variant: 'success', size: 'md' }), 'shrink-0']}
    data-salebar-go
  >
    Cargar la venta
  </button>
</div>
