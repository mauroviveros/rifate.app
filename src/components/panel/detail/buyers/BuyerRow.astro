---
import { Icon } from 'astro-icon/components';

import {
  type BuyerGroup,
  numberLabel,
  previewNumbers,
} from '@/utils/frontmatter/detail';

interface Props {
  buyer: BuyerGroup;
  /** Ancho de padding de las etiquetas (de `numberWidth`). */
  width: number;
  /** Cuántos números del talón se muestran antes del «+N». */
  preview: number;
}

const { buyer, width, preview } = Astro.props;

const label = (n: number) => numberLabel(n, width);
const { shown, hidden } = previewNumbers(buyer.numbers, preview);
const count = buyer.numbers.length;
const unit = count === 1 ? 'número' : 'números';

/* El talón va con « · » en el texto y no separado sólo por gap: un lector de
   pantalla lee «cero uno cero cinco» de corrido si el espacio es CSS (docs/06). */
const stub = shown.map(label).join(' · ');
---

<li>
  {
    hidden > 0 ? (
      <details class="group rounded-lg border-2 border-border">
        <summary class="flex cursor-pointer list-none items-center gap-3 rounded-lg p-4 outline-none focus-visible:ring-3 focus-visible:ring-outline/50 [&::-webkit-details-marker]:hidden">
          <span class="min-w-0 flex-1">
            <span class="flex items-baseline justify-between gap-3">
              <span class="truncate font-bold">{buyer.name}</span>
              {buyer.phone !== null && (
                <span
                  class="shrink-0 text-label text-subtle-foreground"
                  data-numero
                >
                  {buyer.phone}
                </span>
              )}
            </span>
            <span
              class="mt-0.5 flex items-baseline gap-1.5 text-label text-subtle-foreground"
              data-numero
            >
              <span class="truncate">
                {count} {unit} · {stub}
              </span>
              <span class="shrink-0">+{hidden}</span>
            </span>
          </span>

          <Icon
            name="lucide:chevron-down"
            class="size-5 shrink-0 text-subtle-foreground transition-transform group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>

        <div class="border-t-2 border-border px-4 pt-3 pb-4">
          <ul
            class="flex flex-wrap gap-1.5"
            data-numero
            aria-label="Todos los números"
          >
            {buyer.numbers.map((n) => (
              <li class="rounded-xs border-2 border-input bg-background px-2 py-1 text-label font-extrabold">
                {label(n)}
              </li>
            ))}
          </ul>
          {buyer.notes.length > 0 && (
            <p class="mt-3 text-support text-muted-foreground">
              {buyer.notes.join(' — ')}
            </p>
          )}
        </div>
      </details>
    ) : (
      <div class="rounded-lg border-2 border-border p-4">
        <span class="flex items-baseline justify-between gap-3">
          <span class="truncate font-bold">{buyer.name}</span>
          {buyer.phone !== null && (
            <span
              class="shrink-0 text-label text-subtle-foreground"
              data-numero
            >
              {buyer.phone}
            </span>
          )}
        </span>
        <span
          class="mt-0.5 block truncate text-label text-subtle-foreground"
          data-numero
        >
          {count} {unit} · {stub}
        </span>
        {buyer.notes.length > 0 && (
          <p class="mt-2 text-support text-muted-foreground">
            {buyer.notes.join(' — ')}
          </p>
        )}
      </div>
    )
  }
</li>
