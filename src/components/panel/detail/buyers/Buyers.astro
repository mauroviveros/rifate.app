---
/**
 * Quién compró qué. La usan la rifa en venta y la rifa cerrada: en las dos es
 * la misma lista, y en la cerrada es lo único que queda para consultar.
 *
 * El borrador no la monta — no puede haber vendido nada todavía.
 */
import type { HTMLAttributes } from 'astro/types';

import type { OwnerNumber } from '@/types/raffle';
import { buyersOf } from '@/utils/frontmatter/detail';
import { numberWidth } from '@/utils/frontmatter/numbers';

import BuyerRow from './BuyerRow.astro';

interface Props extends HTMLAttributes<'section'> {
  numbers: OwnerNumber[];
  numberStart: number;
  totalNumbers: number;
}

const {
  numbers,
  numberStart,
  totalNumbers,
  class: className,
  ...rest
} = Astro.props;

const buyers = buyersOf(numbers);
const width = numberWidth(numberStart, totalNumbers);

/** Números del talón antes del «+N». */
const PREVIEW = 6;
---

<section
  class:list={['rounded-xl bg-card p-6 ring-2 ring-border', className]}
  aria-labelledby="buyers-title"
  {...rest}
>
  <h2 id="buyers-title" class="text-[1.25rem]">
    Compradores
    {
      buyers.length > 0 && (
        <span class="font-semibold text-subtle-foreground" data-numero>
          {' · '}
          {buyers.length}
        </span>
      )
    }
  </h2>

  {
    buyers.length === 0 ? (
      <p class="mt-2 text-support text-subtle-foreground">
        Todavía no vendiste ningún número. Las ventas que cargues se listan acá.
      </p>
    ) : (
      <ul class="mt-4 flex flex-col gap-2">
        {buyers.map((buyer) => (
          <BuyerRow buyer={buyer} width={width} preview={PREVIEW} />
        ))}
      </ul>
    )
  }
</section>
