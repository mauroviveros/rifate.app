---
/**
 * La rifa sorteada (artboard «Ya sorteada»). Es una pantalla de consulta —
 * quién ganó, cuánto entró, quién compró qué—, sin nada que apretar salvo
 * avisarle al ganador o corregir un dato.
 *
 * La grilla pasa a ser registro y el ganador se come la columna derecha: es
 * lo que se busca primero. En la grilla, el número que salió va en tinta.
 *
 * La cancelada NO pasa por acá desde la fase 9: tiene su propia pantalla,
 * `Cancelled.astro`, porque lo que importa ahí es a quién devolverle la plata.
 */
import type { OwnerNumber, OwnerRaffle } from '@/types/raffle';

import Buyers from './buyers/Buyers.astro';
import Winner from './closed/Winner.astro';
import EditLink from './EditLink.astro';
import Grid from './grid/Grid.astro';
import Stats from './Stats.astro';

interface Props {
  raffle: OwnerRaffle;
  numbers: OwnerNumber[];
}

const { raffle, numbers } = Astro.props;

/** El comprador del número que salió, si se había vendido. */
const sold = numbers.find(
  (n) => n.number === raffle.winnerNumber && n.status === 'SOLD',
);
const buyer =
  sold?.buyerName != null
    ? { name: sold.buyerName, phone: sold.buyerPhone }
    : null;
---

<Stats class="mt-7" numbers={numbers} ticketPrice={raffle.ticketPrice} />

<div
  class:list={[
    'mt-7 grid gap-7',
    'lg:grid-cols-[1fr_380px] lg:items-start lg:gap-7.5',
  ]}
>
  <Grid
    title="El talonario, como quedó"
    hint="Ya no se puede vender ni liberar. Queda de registro."
    numbers={numbers}
    numberStart={raffle.numberStart}
    totalNumbers={raffle.totalNumbers}
    winnerNumber={raffle.winnerNumber}
  />

  <div class="order-first flex flex-col gap-6 lg:sticky lg:top-24 lg:order-0">
    {
      raffle.winnerNumber !== null && (
        <Winner
          raffle={raffle}
          winnerNumber={raffle.winnerNumber}
          buyer={buyer}
        />
      )
    }

    <Buyers
      numbers={numbers}
      numberStart={raffle.numberStart}
      totalNumbers={raffle.totalNumbers}
    />

    <EditLink raffleId={raffle.id} />
  </div>
</div>
