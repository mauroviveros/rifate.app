---
import { Icon } from 'astro-icon/components';

import { button } from '@/components/starwind/button/variants';
---

{
  /* Reserva el alto de la barra fija. Va hasta `lg`, que es cuando la tarjeta
    «Antes de publicar» pasa al costado y ya se ve. */
}
<div class="h-24 lg:hidden" aria-hidden="true"></div>

<div
  class:list={[
    'fixed inset-x-0 bottom-0 z-20 lg:hidden',
    'border-t-2 border-border bg-card px-5 pt-3 pb-4',
    'shadow-[0_-12px_28px_-16px_rgba(23,24,28,0.5)]',
  ]}
>
  <p class="mb-2.5 text-center text-support font-bold text-subtle-foreground">
    Falta el teléfono para poder publicar
  </p>
  <button
    type="button"
    class:list={[button({ variant: 'primary', size: 'md' }), 'w-full']}
    data-goto-phone
  >
    <Icon name="lucide:phone" aria-hidden="true" />
    Cargar el teléfono
  </button>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-goto-phone]');
  const card = document.querySelector<HTMLElement>('#antes-de-publicar');
  const input = card?.querySelector<HTMLInputElement>('[name="contactPhone"]');

  btn?.addEventListener('click', () => {
    card?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    input?.focus({ preventScroll: true });
  });
</script>
