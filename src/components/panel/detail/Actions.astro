---
import { Icon } from 'astro-icon/components';

import CopyLink from '@/components/panel/CopyLink.astro';
import { Button } from '@/components/starwind/button';
import type { OwnerRaffle } from '@/types/raffle';
import { publishHint } from '@/utils/frontmatter/detail';

interface Props {
  raffle: OwnerRaffle;
  /** `actions.raffle.publish`. */
  publishAction: string;
  /** El link público completo (`https://rifate.app/r/slug`). */
  publicUrl: string;
}

const { raffle, publishAction, publicUrl } = Astro.props;

/* En borrador el encabezado tiene editar y publicar. Si falta el teléfono,
   publicar va APAGADO diciendo el motivo (regla 7) y el único vermellón activo
   es el de la tarjeta «Antes de publicar». Con todo listo, publicar acá arriba
   es el único vermellón (regla 2) y la tarjeta ya no repite el botón — así el
   acto queda a la vista sin scrollear, sobre todo en el celular. Publicada, la
   acción es compartir. */
const draft = raffle.status === 'DRAFT';
const publishBlocked = publishHint(raffle);
const editUrl = `/panel/rifa/${raffle.id}/editar`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(
  `${raffle.title} 👉 ${publicUrl}`,
)}`;
---

{
  draft ? (
    <div class="flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:items-center">
      <Button
        href={editUrl}
        variant="outline"
        size="md"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:pencil" aria-hidden="true" />
        Editar los datos
      </Button>

      {publishBlocked ? (
        <Button
          type="button"
          variant="primary"
          size="md"
          disabled
          class="w-full sm:w-auto"
        >
          <Icon name="lucide:circle-alert" aria-hidden="true" />
          {publishBlocked}
        </Button>
      ) : (
        <form method="POST" action={publishAction} class="w-full sm:w-auto">
          <input type="hidden" name="id" value={raffle.id} />
          <Button
            type="submit"
            variant="primary"
            size="md"
            class="w-full sm:w-auto"
          >
            <Icon name="lucide:check" aria-hidden="true" />
            Publicar la rifa
          </Button>
        </form>
      )}
    </div>
  ) : (
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <CopyLink
        class="w-full sm:w-auto"
        value={publicUrl}
        label={publicUrl.replace(/^https?:\/\//, '')}
      />
      <Button
        href={whatsappUrl}
        variant="primary"
        size="md"
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:share-2" aria-hidden="true" />
        Compartir por WhatsApp
      </Button>
    </div>
  )
}
