---
/**
 * Lo que se puede hacer con la rifa, arriba a la derecha del encabezado.
 *
 * Vive acá y no adentro de las pantallas por una restricción de Astro: un
 * `slot="actions"` tiene que ser hijo DIRECTO de `<Dashboard>`. Si lo pusiera
 * `Draft.astro`, ese slot apuntaría a quien llamó a `Draft` —la página— y no
 * llegaría nunca al layout. Por eso el encabezado se queda en la página y los
 * componentes por estado gobiernan el cuerpo.
 *
 * Recibe el mismo `EstadoDetalle` que decide el cuerpo, así que el botón de
 * arriba y la pantalla de abajo no pueden contradecirse.
 *
 * El reparto (regla 2 — un solo vermellón por pantalla):
 *   · borrador  → editar y publicar. Si falta el teléfono, publicar va APAGADO
 *     diciendo el motivo (regla 7), y el único vermellón activo es el de la
 *     tarjeta «Antes de publicar». Con todo listo, el vermellón es este, y la
 *     tarjeta ya no repite el botón: el acto queda a la vista sin scrollear.
 *   · en venta / cerrada → la acción es compartir el link.
 *   · sin grilla → NADA. Compartir el link de una rifa sin números manda a la
 *     gente a una página rota, y publicarla no tendría qué vender.
 */
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';
import CopyLink from '@/components/ui/CopyLink.astro';
import type { OwnerRaffle } from '@/types/raffle';
import type { EstadoDetalle } from '@/utils/frontmatter/detail';
import { publishHint } from '@/utils/frontmatter/detail';

interface Props {
  raffle: OwnerRaffle;
  estado: EstadoDetalle;
  /** El link público completo (`https://rifate.app/r/slug`). */
  publicUrl: string;
}

const { raffle, estado, publicUrl } = Astro.props;

/** Por qué no se puede publicar todavía, o `null` si se puede. */
const blocked = publishHint(raffle);

const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(
  `${raffle.title} 👉 ${publicUrl}`,
)}`;
---

{
  estado === 'borrador' && (
    <div class="flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:items-center">
      <Button
        href={`/panel/rifa/${raffle.id}/editar`}
        variant="outline"
        size="md"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:pencil" aria-hidden="true" />
        Editar los datos
      </Button>

      {blocked ? (
        <Button
          type="button"
          variant="primary"
          size="md"
          disabled
          class="w-full sm:w-auto"
        >
          <Icon name="lucide:circle-alert" aria-hidden="true" />
          {blocked}
        </Button>
      ) : (
        <form
          method="POST"
          action={actions.raffle.publish}
          class="w-full sm:w-auto"
        >
          <input type="hidden" name="id" value={raffle.id} />
          <Button
            type="submit"
            variant="primary"
            size="md"
            class="w-full sm:w-auto"
          >
            <Icon name="lucide:check" aria-hidden="true" />
            Publicar la rifa
          </Button>
        </form>
      )}
    </div>
  )
}

{
  (estado === 'en-venta' || estado === 'cerrada') && (
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <CopyLink
        class="w-full sm:w-auto"
        value={publicUrl}
        label={publicUrl.replace(/^https?:\/\//, '')}
      />

      <Button
        href={whatsappUrl}
        variant="primary"
        size="md"
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:share-2" aria-hidden="true" />
        Compartir por WhatsApp
      </Button>
    </div>
  )
}
