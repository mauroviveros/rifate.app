---
/**
 * Lo que se puede hacer con la rifa, arriba a la derecha del encabezado.
 *
 * Vive acá y no adentro de las pantallas por una restricción de Astro: un
 * `slot="actions"` tiene que ser hijo DIRECTO de `<Dashboard>`. Si lo pusiera
 * `Draft.astro`, ese slot apuntaría a quien llamó a `Draft` —la página— y no
 * llegaría nunca al layout. Por eso el encabezado se queda en la página y los
 * componentes por estado gobiernan el cuerpo.
 *
 * Recibe el mismo `EstadoDetalle` que decide el cuerpo, así que el botón de
 * arriba y la pantalla de abajo no pueden contradecirse.
 *
 * El reparto (regla 2 — un solo vermellón por pantalla):
 *   · borrador  → editar y publicar. Si falta el teléfono, publicar va APAGADO
 *     diciendo el motivo (regla 7), y el único vermellón activo es el de la
 *     tarjeta «Antes de publicar». Con todo listo, el vermellón es este, y la
 *     tarjeta ya no repite el botón: el acto queda a la vista sin scrollear.
 *   · en venta → compartir: el link, y la imagen del estado para el grupo.
 *     El vermellón es el de WhatsApp; la imagen va con borde.
 *   · sorteada → contar quién ganó: el link, y el vermellón pasa a ser
 *     «Compartir quién ganó», con el número y el nombre ya escritos.
 *   · cancelada y sin grilla → NADA. El link de una cancelada ya no abre, y
 *     el de una rifa sin números manda a la gente a una página rota.
 */
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';
import CopyLink from '@/components/ui/CopyLink.astro';
import type { OwnerRaffle, PublicNumber } from '@/types/raffle';
import type { EstadoDetalle } from '@/utils/frontmatter/detail';
import {
  publishHint,
  shareImageInput,
  winnerShareText,
} from '@/utils/frontmatter/detail';

import ShareImage from './ShareImage.astro';

interface Props {
  raffle: OwnerRaffle;
  estado: EstadoDetalle;
  /** El link público completo (`https://rifate.app/r/slug`). */
  publicUrl: string;
  /** La grilla, para la imagen del estado. Sólo se usa número y estado. */
  numbers: PublicNumber[];
}

const { raffle, estado, publicUrl, numbers } = Astro.props;
/** Por qué no se puede publicar todavía, o `null` si se puede. */
const blocked = publishHint(raffle);
/** Lo que acompaña al link y a la imagen cuando se comparten. */
const shareText = `${raffle.title} 👉 ${publicUrl}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const winnerUrl = `https://wa.me/?text=${encodeURIComponent(winnerShareText(raffle, publicUrl))}`;
const linkLabel = publicUrl.replace(/^https?:\/\//, '');
---

{
  estado === 'borrador' && (
    <div class="flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:items-center">
      <Button
        href={`/panel/rifa/${raffle.id}/editar`}
        variant="outline"
        size="md"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:pencil" aria-hidden="true" />
        Editar los datos
      </Button>

      {blocked ? (
        <Button
          type="button"
          variant="primary"
          size="md"
          disabled
          class="w-full sm:w-auto"
        >
          <Icon name="lucide:circle-alert" aria-hidden="true" />
          {blocked}
        </Button>
      ) : (
        <form
          method="POST"
          action={actions.raffle.publish}
          class="w-full sm:w-auto"
        >
          <input type="hidden" name="id" value={raffle.id} />
          <Button
            type="submit"
            variant="primary"
            size="md"
            class="w-full sm:w-auto"
          >
            <Icon name="lucide:check" aria-hidden="true" />
            Publicar la rifa
          </Button>
        </form>
      )}
    </div>
  )
}

{
  estado === 'cerrada' && (
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <CopyLink class="w-full sm:w-auto" value={publicUrl} label={linkLabel} />

      <Button
        href={winnerUrl}
        variant="primary"
        size="md"
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:trophy" aria-hidden="true" />
        Compartir quién ganó
      </Button>
    </div>
  )
}

{
  estado === 'en-venta' && (
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <CopyLink class="w-full sm:w-auto" value={publicUrl} label={linkLabel} />

      <ShareImage
        class="w-full sm:w-auto"
        input={shareImageInput(raffle, numbers)}
        filename={raffle.slug}
      />

      <Button
        href={whatsappUrl}
        variant="primary"
        size="md"
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto"
      >
        <Icon name="lucide:share-2" aria-hidden="true" />
        Compartir por WhatsApp
      </Button>
    </div>
  )
}
