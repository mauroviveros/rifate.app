---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';

import type { OwnerNumber } from '@/types/raffle';
import { numberWidth } from '@/utils/frontmatter/detail';

import Cell from './Cell.astro';

interface Props extends HTMLAttributes<'section'> {
  /** El `id` del <form> del panel de venta. Sin él la grilla es sólo lectura. */
  form?: string;
  /** Rifa en DRAFT: la grilla es la vista previa y va con el pill «Los N están libres». */
  draft?: boolean;
  numbers: OwnerNumber[];
  numberStart: number;
  /** Números tildados desde el server (repoblado tras un error). */
  selected?: number[];
  totalNumbers: number;
}

const {
  class: className,
  form,
  draft = false,
  numbers,
  numberStart,
  selected = [],
  totalNumbers,
  ...rest
} = Astro.props;

const width = numberWidth(numberStart, totalNumbers);
const picked = new Set(selected);
const readOnly = form === undefined;
---

<section
  class:list={['rounded-xl bg-card p-4 ring-2 ring-border sm:p-6', className]}
  aria-labelledby="grid-title"
  {...rest}
>
  <h2 id="grid-title" class="text-[1.25rem]">
    {draft ? 'Así la va a ver la gente' : 'Los números'}
  </h2>
  <p class="mt-0.5 text-label text-subtle-foreground">
    {
      draft
        ? 'Todavía no podés anotar ventas: la rifa no está publicada.'
        : readOnly
          ? 'La rifa está cerrada: la grilla quedó como terminó.'
          : 'Tocá los que quieras vender. Los tachados ya están vendidos: tocalos para liberarlos.'
    }
  </p>

  <div class="relative mt-4">
    <div
      class:list={[
        'grid grid-cols-5 gap-1.5 sm:grid-cols-10 sm:gap-1',
        readOnly && 'opacity-55',
      ]}
      role="group"
      aria-label="Números de la rifa"
    >
      {
        numbers.map(({ number, status }) => (
          <Cell
            value={number}
            status={status}
            width={width}
            form={form}
            readOnly={readOnly}
            checked={picked.has(number)}
          />
        ))
      }
    </div>

    {
      draft && (
        <p class="absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center gap-2 rounded-full bg-foreground px-5 py-2.5 text-support font-extrabold whitespace-nowrap text-background shadow-lg">
          <Icon name="lucide:lock" class="size-4.5 text-warning" />
          Los {numbers.length} están libres
        </p>
      )
    }
  </div>
</section>
