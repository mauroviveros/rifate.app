---
/**
 * El talonario dibujado: la tarjeta, el encabezado y los números.
 *
 * NO sabe en qué estado está la rifa. La versión anterior recibía `form?` y
 * `draft?` y deducía de ahí si era de sólo lectura, con lo cual dos props
 * hacían de discriminante encubierto y el copy de las tres pantallas vivía
 * acá adentro en una cadena de ternarios. Ahora cada pantalla trae sus
 * palabras y la grilla se ocupa de dibujar números.
 */
import type { HTMLAttributes } from 'astro/types';

import Cell from '@/components/raffle/Cell.astro';
import type { OwnerNumber } from '@/types/raffle';
import { numberWidth } from '@/utils/frontmatter/numbers';

import SellCell from './SellCell.astro';

interface Props extends HTMLAttributes<'section'> {
  title: string;
  hint: string;
  numbers: OwnerNumber[];
  numberStart: number;
  totalNumbers: number;
  /** Apaga la grilla cuando no se puede tocar (borrador, rifa cerrada). */
  dimmed?: boolean;
  /**
   * El `id` del `<form>` del panel de venta. Con él los números se tildan y se
   * mandan; sin él son de sólo mirar.
   *
   * Es un dato de HTML —a qué formulario pertenece este control—, no el estado
   * de la rifa disfrazado: quién decide si esta pantalla vende es la pantalla,
   * que pasa o no pasa el `form`. Lo que el `Grid` anterior hacía mal era otra
   * cosa: de ese mismo `form` deducía además el copy del encabezado.
   */
  form?: string;
  /** Números ya tildados, para repoblar tras un error de validación. */
  selected?: number[];
}

const {
  title,
  hint,
  numbers,
  numberStart,
  totalNumbers,
  dimmed = false,
  form,
  selected = [],
  class: className,
  ...rest
} = Astro.props;

const width = numberWidth(numberStart, totalNumbers);
const picked = new Set(selected);
---

<section
  class:list={['rounded-xl bg-card p-4 ring-2 ring-border sm:p-6', className]}
  aria-labelledby="grid-title"
  {...rest}
>
  <h2 id="grid-title" class="text-[1.25rem]">{title}</h2>
  <p class="mt-0.5 text-label text-subtle-foreground">{hint}</p>

  <div class="relative mt-4">
    <div
      class:list={[
        'grid grid-cols-5 gap-1.5 sm:grid-cols-10 sm:gap-1',
        dimmed && 'opacity-55',
      ]}
      role="group"
      aria-label="Números de la rifa"
    >
      {
        numbers.map(({ number, status }) =>
          form ? (
            <SellCell
              value={number}
              status={status}
              width={width}
              form={form}
              checked={picked.has(number)}
            />
          ) : (
            <Cell value={number} status={status} width={width} />
          ),
        )
      }
    </div>

    <slot />
  </div>
</section>
