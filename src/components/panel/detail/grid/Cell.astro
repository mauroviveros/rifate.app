---
/**
 * Un número del talonario, de sólo lectura.
 *
 * Todavía no existe la versión tildable: la va a necesitar la pantalla de venta
 * (`OnSale`), que es la única donde se puede anotar algo. Mientras tanto esto
 * es lo que ven el borrador y la rifa cerrada — mirar, no tocar.
 */
import type { NumberStatus } from '@/types/raffle';
import { numberLabel } from '@/utils/frontmatter/numbers';

interface Props {
  status: NumberStatus;
  value: number;
  /** Ancho de padding de la etiqueta (de `numberWidth`). */
  width: number;
}

const { status, value, width } = Astro.props;

/** Vendido o reservado: para el que mira, las dos cosas son «ya no está». */
const taken = status === 'SOLD' || status === 'RESERVED';
---

<div
  class:list={[
    'flex aspect-square items-center justify-center',
    'rounded-md border-2 text-support font-extrabold select-none',
    taken
      ? 'border-border bg-muted tachado text-disabled-foreground'
      : 'border-input bg-card text-foreground',
  ]}
>
  <span data-numero>{numberLabel(value, width)}</span>
  {taken && <span class="sr-only"> · vendido</span>}
</div>
