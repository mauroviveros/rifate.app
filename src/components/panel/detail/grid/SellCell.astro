---
/**
 * Un número tildable, atado al `<form>` del panel de venta.
 *
 * Es un `<label>` con un checkbox escondido: el número entero es el área
 * clickeable, que en un celular es la diferencia entre poder tocarlo y no.
 * El `form=` es lo que lo ata al panel aunque el panel esté en otra columna
 * del DOM — sin eso habría que envolver media pantalla en un `<form>`.
 *
 * La celda de sólo mirar es `Cell.astro`, y son dos archivos a propósito: un
 * `<div>` y un `<label>`+`<input>` no comparten ni el elemento ni las clases,
 * así que un flag para elegir entre los dos esconde dos componentes en uno.
 */
import type { NumberStatus } from '@/types/raffle';
import { numberLabel } from '@/utils/frontmatter/numbers';

interface Props {
  status: NumberStatus;
  value: number;
  /** Ancho de padding de la etiqueta (de `numberWidth`). */
  width: number;
  /** El `id` del `<form>` del panel al que se ata el checkbox. */
  form: string;
  /** Tildado desde el server, para repoblar tras un error de validación. */
  checked?: boolean;
}

const { status, value, width, form, checked = false } = Astro.props;

/**
 * Vendido o reservado. Se puede tildar igual: es como se liberan, sin pasar
 * por otra pantalla. Por eso «ocupado» no es «deshabilitado».
 */
const taken = status === 'SOLD' || status === 'RESERVED';

const BASE = [
  'flex aspect-square items-center justify-center',
  'rounded-md border-2 text-support font-extrabold transition-all select-none',
  'has-focus-visible:ring-3 has-focus-visible:ring-outline/50',
];

const FREE = [
  'cursor-pointer border-input bg-card text-foreground hover:-translate-y-0.5',
  'has-checked:border-foreground has-checked:bg-foreground',
  'has-checked:text-background has-checked:sello-primary',
];

const TAKEN = [
  'tachado cursor-not-allowed border-border bg-muted text-disabled-foreground',
  'has-checked:border-primary has-checked:text-foreground has-checked:sello-primary',
];
---

<label class:list={[BASE, taken ? TAKEN : FREE]}>
  <input
    type="checkbox"
    name="numbers"
    value={value}
    form={form}
    checked={checked}
    data-taken={taken ? '' : undefined}
    class="sr-only"
  />
  <span data-numero>{numberLabel(value, width)}</span>
  {taken && <span class="sr-only"> · vendido</span>}
</label>
