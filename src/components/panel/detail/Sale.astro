---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';

import Field from '@/components/form/Field.astro';
import { button } from '@/components/starwind/button/variants';
import { formValue } from '@/utils/forms';

interface Props extends HTMLAttributes<'form'> {
  error: string | null;
  errors: Record<string, string[] | undefined>;
  formData: FormData | null;
  raffleId: string;
  releaseAction: string;
  sellAction: string;
  /** Precio del número, en centavos: para el «Cobrás» en vivo. */
  ticketPrice: number;
}

const {
  class: className,
  error,
  errors,
  formData,
  id,
  raffleId,
  releaseAction,
  sellAction,
  ticketPrice,
  ...rest
} = Astro.props;

const value = (name: string) => formValue(formData, name);
---

<form
  id={id}
  method="POST"
  novalidate
  data-sale
  data-price={ticketPrice}
  class:list={[
    'rounded-xl bg-card p-6 ring-2 ring-border transition-shadow',
    'data-[kind=release]:ring-foreground data-[kind=sell]:ring-success',
    className,
  ]}
  {...rest}
>
  <input type="hidden" name="id" value={raffleId} />

  <h2 class="text-[1.25rem]">Venta en curso</h2>
  <p
    class="mt-0.5 text-support font-bold text-subtle-foreground"
    data-sale-sentence
    data-numero
  >
    Elegí números de la grilla para vender o liberar.
  </p>
  <div class="mt-3 flex flex-wrap gap-1.5" data-sale-chips data-numero></div>

  <hr class="my-5 perforado" />

  {
    error && (
      <p
        class="mb-5 flex items-start gap-2.5 rounded-lg bg-error/8 p-4 text-support font-bold text-error"
        role="alert"
      >
        <Icon name="lucide:circle-alert" class="mt-0.5 size-5.5 shrink-0" />
        <span>{error}</span>
      </p>
    )
  }

  <Field
    name="name"
    label="¿Quién los compró?"
    placeholder="Samira Viveros"
    value={value('name')}
    errors={errors.name}
  />

  <Field
    class="mt-5"
    name="phone"
    label="Teléfono"
    hint="Para avisarle si gana, y para juntarlo si vuelve a comprar."
    type="tel"
    inputmode="tel"
    placeholder="11 2345-6789"
    value={value('phone')}
    errors={errors.phone}
    optional
  />

  <Field
    class="mt-5"
    name="note"
    label="Nota"
    hint="Para vos. Por ejemplo: «pagó por transferencia»."
    type="textarea"
    value={value('note')}
    errors={errors.note}
    optional
  />

  <div class="mt-6 hidden items-baseline justify-between" data-sale-cobras>
    <span class="text-support font-bold text-subtle-foreground">Cobrás</span>
    <span
      class="font-display text-2xl font-extrabold tracking-tight text-success"
      data-sale-total
      data-numero
    >
    </span>
  </div>

  <div class="mt-6 grid gap-2.5">
    <button
      type="submit"
      formaction={sellAction}
      class={button({ variant: 'success', size: 'md' })}
      data-sale-sell
    >
      <Icon name="lucide:check" aria-hidden="true" />
      <span data-sale-sell-label>Marcar como vendidos</span>
    </button>
    <button
      type="submit"
      formaction={releaseAction}
      class={button({ variant: 'outline', size: 'md' })}
      data-sale-release
    >
      Liberar
    </button>
  </div>

  <p
    class="mt-3 text-center text-label text-subtle-foreground"
    data-sale-hint
    role="status"
  >
    Elegí números de la grilla para vender o liberar.
  </p>
</form>

<script>
  import { pesos } from '@/utils/format';
  import type { SelectionKind } from '@/utils/frontmatter/detail';
  import { selectionKind } from '@/utils/frontmatter/detail';

  const form = document.querySelector<HTMLFormElement>('[data-sale]');
  if (form) {
    const priceCents = Number(form.dataset.price ?? '0');
    const boxes = [
      ...document.querySelectorAll<HTMLInputElement>('input[name="numbers"]'),
    ];
    const byValue = new Map(boxes.map((b) => [b.value, b]));

    const $sentence = form.querySelector<HTMLElement>('[data-sale-sentence]')!;
    const $cobras = form.querySelector<HTMLElement>('[data-sale-cobras]')!;
    const $total = form.querySelector<HTMLElement>('[data-sale-total]')!;
    const $chips = form.querySelector<HTMLElement>('[data-sale-chips]')!;
    const $hint = form.querySelector<HTMLElement>('[data-sale-hint]')!;
    const $sell = form.querySelector<HTMLButtonElement>('[data-sale-sell]')!;
    const $sellLabel = form.querySelector<HTMLElement>(
      '[data-sale-sell-label]',
    )!;
    const $release = form.querySelector<HTMLButtonElement>(
      '[data-sale-release]',
    )!;
    const $name = form.querySelector<HTMLInputElement>('[name="name"]');

    // La barra fija de celular, si está montada.
    const $bar = document.querySelector<HTMLElement>('[data-salebar]');
    const $barText = document.querySelector<HTMLElement>('[data-salebar-text]');
    const $barButton =
      document.querySelector<HTMLButtonElement>('[data-salebar-go]');

    const s = (n: number) => (n === 1 ? '' : 's');

    const SENTENCE: Record<SelectionKind, (n: number) => string> = {
      empty: () => 'Elegí números de la grilla para vender o liberar.',
      sell: (n) => `Vas a marcar ${n} número${s(n)} como vendido${s(n)}.`,
      release: (n) => `Vas a liberar ${n} número${s(n)}.`,
      mixed: () =>
        'Elegiste números libres y vendidos juntos. Va uno o el otro.',
    };
    const HINT: Record<SelectionKind, string> = {
      empty: 'Elegí números de la grilla.',
      sell: '',
      release: '',
      mixed: 'No se puede vender y liberar a la vez.',
    };

    const drawChips = (picked: HTMLInputElement[]) => {
      $chips.replaceChildren(
        ...picked.map((b) => {
          const n = Number(b.value);
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.dataset.chip = b.value;
          chip.setAttribute('aria-label', `Quitar el ${n}`);
          chip.className =
            'inline-flex items-center gap-1 rounded-md bg-foreground px-2 py-1 text-label font-extrabold text-background';
          const x = document.createElement('span');
          x.textContent = '×';
          x.className = 'text-background/60';
          x.setAttribute('aria-hidden', 'true');
          chip.textContent = String(n);
          chip.appendChild(x);
          return chip;
        }),
      );
    };

    const paint = () => {
      const picked = boxes.filter((b) => b.checked);
      const count = picked.length;
      const kind = selectionKind(
        picked.map((b) => b.dataset.taken !== undefined),
      );

      form.dataset.kind = count === 0 ? '' : kind;
      $sentence.textContent = SENTENCE[kind](count);
      drawChips(picked);

      const total = pesos(count * priceCents);
      const showTotal = kind === 'sell' && priceCents > 0;
      // Toggle de CLASES, no del atributo: `el.hidden = false` no le gana a la
      // clase `hidden` de Tailwind, y la fila necesita `flex` para el layout.
      $cobras.classList.toggle('hidden', !showTotal);
      $cobras.classList.toggle('flex', showTotal);
      $total.textContent = showTotal ? total : '';

      $sell.disabled = kind !== 'sell';
      $release.disabled = kind !== 'release';
      $sellLabel.textContent =
        kind === 'sell'
          ? `Marcar ${count} número${s(count)} como vendido${s(count)}`
          : 'Marcar como vendidos';
      $release.textContent =
        kind === 'release' ? `Liberar ${count} número${s(count)}` : 'Liberar';

      $hint.textContent = HINT[kind];
      $hint.hidden = HINT[kind] === '';

      if ($bar && $barText && $barButton) {
        $bar.classList.toggle('hidden', count === 0);
        $bar.classList.toggle('flex', count > 0);
        $barText.textContent =
          kind === 'sell'
            ? `${count} número${s(count)} · ${total}`
            : kind === 'release'
              ? `${count} número${s(count)} a liberar`
              : 'Libres o vendidos, no los dos';
        $barButton.disabled = kind === 'mixed';
        $barButton.textContent =
          kind === 'release' ? 'Ir a liberar' : 'Cargar la venta';
      }
    };

    $chips.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>(
        '[data-chip]',
      );
      const box = chip && byValue.get(chip.dataset.chip ?? '');
      if (box) {
        box.checked = false;
        box.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });

    $barButton?.addEventListener('click', () => {
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      $name?.focus({ preventScroll: true });
    });

    for (const box of boxes) box.addEventListener('change', paint);
    paint();
  }
</script>
