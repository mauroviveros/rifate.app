---
/**
 * El número que salió, arriba de la columna derecha (artboard «Ya sorteada»).
 * Es lo primero que alguien busca al abrir una rifa sorteada.
 *
 * El número va acolchado con el mismo ancho que la grilla —`07` y no `7`—:
 * quien lo busca lo busca contra el talonario, no contra un número suelto.
 *
 * El comprador sale de la grilla del objeto y no de `winner_name` de D1: la
 * grilla trae el teléfono, que es para avisarle, y es la verdad. Puede no
 * haber comprador: el número cargado a mano puede ser uno que no se vendió.
 * La pantalla lo dice así, sin inventar un ganador.
 */
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';
import type { OwnerRaffle } from '@/types/raffle';
import { winnerNotice } from '@/utils/frontmatter/detail';
import { numberLabel, numberWidth } from '@/utils/frontmatter/numbers';
import { localPhone, waLink } from '@/utils/whatsapp';

interface Props {
  raffle: OwnerRaffle;
  /** El número ganador. Lo chequea quien monta esto: acá ya no es `null`. */
  winnerNumber: number;
  /** Quién lo había comprado, o `null` si no se vendió. */
  buyer: { name: string; phone: string | null } | null;
}

const { raffle, winnerNumber, buyer } = Astro.props;

const label = numberLabel(
  winnerNumber,
  numberWidth(raffle.numberStart, raffle.totalNumbers),
);

const notify =
  buyer?.phone != null
    ? waLink(buyer.phone, winnerNotice(raffle, winnerNumber, buyer.name))
    : null;
---

<section
  class="rounded-xl bg-foreground p-6 text-background"
  aria-labelledby="winner-title"
>
  <h2
    id="winner-title"
    class="text-label font-extrabold tracking-[0.08em] text-background/60"
  >
    {buyer ? 'GANADOR' : 'SALIÓ EL'}
  </h2>

  <p
    class="mt-1 font-display text-display leading-none font-extrabold tracking-tight text-warning"
    data-numero
  >
    {label}
  </p>

  {
    buyer ? (
      <>
        <p class="mt-3 font-display text-[1.75rem] leading-tight font-extrabold">
          {buyer.name}
        </p>
        {buyer.phone !== null ? (
          <p class="mt-0.5 text-support text-background/70" data-numero>
            {localPhone(buyer.phone)}
          </p>
        ) : (
          <p class="mt-0.5 text-support text-background/70">
            No dejó teléfono: avisale a mano.
          </p>
        )}
      </>
    ) : (
      <p class="mt-3 text-support text-background/80">
        Nadie lo había comprado, así que no hay ganador. Qué pasa con el premio
        lo decidís vos.
      </p>
    )
  }

  {
    notify && (
      <Button
        href={notify}
        variant="success"
        size="md"
        target="_blank"
        rel="noopener"
        class="mt-5 w-full"
      >
        <Icon name="lucide:message-circle" aria-hidden="true" />
        Avisarle por WhatsApp
      </Button>
    )
  }
</section>
