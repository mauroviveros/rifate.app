---
import { Icon } from 'astro-icon/components';

interface Props {
  /** El texto que se copia. */
  value: string;
  /** Lo que se muestra; por defecto, el `value`. */
  label?: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
const shown = label ?? value;
---

<div
  class:list={[
    'inline-flex min-w-0 items-center gap-2 rounded-lg border-2 border-border bg-background px-3 py-1.5',
    className,
  ]}
  data-copy-link
  data-value={value}
>
  <span class="truncate text-label font-semibold text-muted-foreground">
    {shown}
  </span>

  <button
    type="button"
    class="group/copy flex size-7 shrink-0 items-center justify-center rounded-md text-subtle-foreground transition-colors hover:bg-foreground/5 hover:text-foreground focus-visible:ring-3 focus-visible:ring-outline/50"
    data-copy-button
    aria-label="Copiar el link"
  >
    <Icon
      name="lucide:copy"
      class="size-4.5 group-data-copied/copy:hidden"
      aria-hidden="true"
    />
    <Icon
      name="lucide:check"
      class="hidden size-4.5 text-success group-data-copied/copy:block"
      aria-hidden="true"
    />
  </button>

  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  const $boxes = document.querySelectorAll<HTMLDivElement>('[data-copy-link]');
  for (const $box of $boxes) {
    const $button = $box.querySelector<HTMLButtonElement>('[data-copy-button]');
    const $status = $box.querySelector<HTMLSpanElement>('[data-copy-status]');
    const value = $box.dataset.value ?? '';
    if (!$button) continue;

    $button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value);
        $button.dataset.copied = '';

        if ($status) $status.textContent = 'Link copiado';

        setTimeout(() => {
          delete $button.dataset.copied;
          if ($status) $status.textContent = '';
        }, 2000);
      } catch {
        if ($status) $status.textContent = 'No se pudo copiar';
      }
    });
  }
</script>
