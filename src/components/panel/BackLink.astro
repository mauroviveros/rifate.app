---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  label?: string;
}

const { href = '/panel', label = 'Volver a mis rifas' } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class:list={[
    'flex shrink-0 items-center gap-2 text-support font-bold text-background/75',
    'transition-colors hover:text-background',
  ]}
>
  <Icon name="lucide:arrow-left" class="size-4.5" aria-hidden="true" />
  <span class="hidden sm:inline">{label}</span>
</a>
