---
import { formValue } from '@/utils/forms';
import {
  PREVIEW_CELL_CLASS,
  summarySnapshot,
} from '@/utils/frontmatter/summary';

interface Props {
  formData: FormData | null;
  /** Los valores actuales, para el primer GET de la edición (ver `Form`). */
  initial?: Record<string, string>;
}

const { formData, initial } = Astro.props;
const value = (name: string) =>
  formValue(formData, name) || initial?.[name] || '';

/* La misma cuenta que rehace el <script> de abajo en cada tecla. */
const summary = summarySnapshot({
  title: value('title'),
  description: value('description'),
  ticketPrice: value('ticketPrice'),
  totalNumbers: value('totalNumbers'),
  numberStart: value('numberStart'),
});
---

<aside class="flex flex-col gap-5">
  <div
    class="rounded-xl bg-warning p-6 ring-2 ring-warning/70"
    data-summary-total
  >
    <h2
      class="text-support font-extrabold tracking-[0.04em] text-warning-foreground/70"
    >
      SI VENDÉS TODO
    </h2>

    <p class="mt-1 font-display text-display font-extrabold" data-numero>
      <output data-total>{summary.total}</output>
    </p>

    <div
      class="my-4 perforado opacity-40"
      style="--input:var(--color-warning-foreground);"
      aria-hidden="true"
    >
    </div>

    <p
      class="flex justify-between text-[1.0625rem] font-bold text-warning-foreground/85"
      data-numero
    >
      <span><output data-cantidad>{summary.totalNumbers}</output> números</span>
      <span aria-hidden="true">×</span>
      <span><output data-precio>{summary.ticketPrice}</output></span>
    </p>
  </div>

  <div class="rounded-xl bg-card p-6 ring-2 ring-border">
    <h2 class="text-[1.25rem]">Así lo van a ver</h2>
    <p class="text-label text-subtle-foreground">Vista previa de tu link.</p>

    <div class="mt-4 rounded-lg bg-foreground p-4.5 text-background">
      <p class="font-display text-[1.3125rem] font-extrabold tracking-tight">
        <span data-preview-title>{summary.title}</span>
      </p>
      <p class="text-label text-background/75">
        <span data-preview-description>{summary.description}</span>
      </p>
    </div>

    <ul
      class="mt-3.5 grid grid-cols-10 gap-1"
      aria-hidden="true"
      data-preview-grid
    >
      {
        summary.numbers.map((number) => (
          <li class={PREVIEW_CELL_CLASS} data-numero>
            {number}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="rounded-xl border-3 border-dashed border-input p-5.5">
    <h2 class="text-[1.1875rem]">Un consejo</h2>
    <p class="mt-1 text-support text-muted-foreground">
      Cuantos menos números tenga la rifa, más rápido se vende. Si es tu primera
      vez, arrancá con 100.
    </p>
  </div>
</aside>

<script>
  import {
    PREVIEW_CELL_CLASS,
    summarySnapshot,
  } from '@/utils/frontmatter/summary';

  const $total = document.querySelector<HTMLElement>('[data-total]');
  const $cantidad = document.querySelector<HTMLElement>('[data-cantidad]');
  const $precio = document.querySelector<HTMLElement>('[data-precio]');
  const $previewTitle = document.querySelector<HTMLElement>(
    '[data-preview-title]',
  );
  const $previewDescription = document.querySelector<HTMLElement>(
    '[data-preview-description]',
  );
  const $grid = document.querySelector<HTMLElement>('[data-preview-grid]');

  if (
    $total &&
    $cantidad &&
    $precio &&
    $previewTitle &&
    $previewDescription &&
    $grid
  ) {
    const field = {
      title: document.querySelector<HTMLInputElement>('[name="title"]'),
      description: document.querySelector<HTMLTextAreaElement>(
        '[name="description"]',
      ),
      ticketPrice: document.querySelector<HTMLInputElement>(
        '[name="ticketPrice"]',
      ),
      totalNumbers: document.querySelector<HTMLInputElement>(
        '[name="totalNumbers"]',
      ),
    };

    /* Lo único que hace el cliente distinto del server es de DÓNDE lee: acá de
       los inputs, allá del FormData. La cuenta es la misma función. */
    const draw = () => {
      const summary = summarySnapshot({
        title: field.title?.value ?? '',
        description: field.description?.value ?? '',
        ticketPrice: field.ticketPrice?.value ?? '',
        totalNumbers: field.totalNumbers?.value ?? '',
        numberStart:
          document.querySelector<HTMLInputElement>(
            '[name="numberStart"]:checked',
          )?.value ?? '',
      });

      $total.textContent = summary.total;
      $cantidad.textContent = String(summary.totalNumbers);
      $precio.textContent = summary.ticketPrice;
      $previewTitle.textContent = summary.title;
      $previewDescription.textContent = summary.description;

      $grid.replaceChildren(
        ...summary.numbers.map((number) => {
          const li = document.createElement('li');
          li.className = PREVIEW_CELL_CLASS;
          li.dataset.numero = '';
          li.textContent = number;
          return li;
        }),
      );
    };

    for (const input of Object.values(field)) {
      input?.addEventListener('input', draw);
    }

    for (const radio of document.querySelectorAll<HTMLInputElement>(
      '[name="numberStart"]',
    )) {
      radio.addEventListener('change', draw);
    }
  }
</script>
