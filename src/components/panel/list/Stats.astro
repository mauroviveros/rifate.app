---
import type { HTMLAttributes } from 'astro/types';

import Meter from '@/components/panel/Meter.astro';
import Stat from '@/components/panel/Stat.astro';
import type { RaffleListItem } from '@/types/raffle';
import { pesos, progress } from '@/utils/format';

interface Props extends HTMLAttributes<'dl'> {
  raffles: RaffleListItem[];
}

const { raffles, class: className, ...rest } = Astro.props;
const enVenta = raffles.filter((r) => r.status === 'PUBLISHED');
const vendidos = enVenta.reduce((t, r) => t + r.soldCount, 0);
const numeros = enVenta.reduce((t, r) => t + r.totalNumbers, 0);
const recaudado = enVenta.reduce((t, r) => t + r.soldCount * r.ticketPrice, 0);
const avance = progress(vendidos, numeros);
---

<dl
  class:list={[
    'mt-8 grid grid-cols-2 gap-3 sm:mt-9 sm:gap-5 lg:grid-cols-4',
    className,
  ]}
  aria-label="Resumen de tus rifas"
  {...rest}
>
  <Stat label="Rifas en venta" class="hidden sm:flex">{enVenta.length}</Stat>

  <Stat label="Números vendidos" shortLabel="Vendidos">
    {vendidos}
    &nbsp;
    <span class="text-xl text-subtle-foreground sm:text-2xl">de {numeros}</span>
  </Stat>

  <Stat label="Recaudado" tone="ink">{pesos(recaudado)}</Stat>

  <Meter label="Avance general" value={avance} class="hidden sm:flex" />
</dl>
