---
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';
import type { RaffleListItem } from '@/types/raffle';
import { pesos, progress, shortDate } from '@/utils/format';
import {
  ACCION,
  BADGE,
  bajadaDe,
  estadoDe,
  puntosDe,
} from '@/utils/frontmatter/raffle';

export interface Props {
  rifa: RaffleListItem;
  /** El día del calendario a partir del cual una rifa está en «últimos días».
      Lo calcula la página una vez por request y baja por prop: si fuera un
      `const` de módulo se congelaría con el isolate de Workers. */
  limite: string;
}

const { rifa, limite } = Astro.props;

const estadoActual = estadoDe(rifa, limite);
const cerrada = estadoActual === 'cerrada';

const estado = BADGE[estadoActual];
const accion = ACCION[estadoActual];
const puntos = puntosDe(rifa);
const bajada = bajadaDe(rifa, cerrada);
const porcentaje = progress(rifa.soldCount, rifa.totalNumbers);
const soloEscritorio = cerrada ? 'hidden sm:flex' : 'flex';
---

<li class="flex flex-col">
  <article
    class="flex flex-1 flex-col rounded-xl bg-card p-6 ring-2 ring-border"
  >
    <div class="mb-1.5 flex items-start justify-between gap-3">
      <h2 class="text-[1.375rem] sm:text-2xl">{rifa.title}</h2>
      <span
        class:list={[
          'shrink-0 rounded-full px-2.5 py-1.5',
          'text-label font-extrabold',
          estado.clase,
        ]}
      >
        {estado.texto}
      </span>
    </div>

    {
      bajada && (
        <p class="mb-4.5 text-support text-subtle-foreground">{bajada}</p>
      )
    }

    <ul class="mb-4.5 hidden flex-wrap gap-1 sm:flex" aria-hidden="true">
      {
        puntos.map((vendido) => (
          <li
            class:list={[
              'size-2.25 rounded-[3px]',
              cerrada
                ? 'bg-disabled-foreground/55'
                : vendido
                  ? 'bg-primary'
                  : 'bg-border',
            ]}
          />
        ))
      }
    </ul>

    <div
      class:list={['mb-2 items-baseline justify-between gap-3', soloEscritorio]}
    >
      <span class="text-support font-bold sm:text-body" data-numero>
        {rifa.soldCount} de {rifa.totalNumbers} vendidos
      </span>
      <span
        class:list={[
          'font-display text-xl font-extrabold tracking-tight',
          cerrada || porcentaje === 0
            ? 'text-subtle-foreground'
            : 'text-success',
        ]}
        data-numero
      >
        {porcentaje}%
      </span>
    </div>

    <div
      class="mb-4.5 h-3 overflow-hidden rounded-full bg-border"
      aria-hidden="true"
    >
      <div
        class:list={[
          'h-full rounded-full',
          cerrada ? 'bg-disabled-foreground/55' : 'bg-success',
        ]}
        style={`width: ${porcentaje}%`}
      >
      </div>
    </div>

    <div class:list={['mb-4 perforado', cerrada && 'hidden sm:block']}></div>

    <div
      class:list={['mb-4.5 items-center justify-between gap-3', soloEscritorio]}
    >
      <span
        class="flex items-center gap-2 text-label font-semibold text-muted-foreground"
      >
        <Icon
          name="lucide:calendar"
          class="size-4.5 shrink-0 text-subtle-foreground"
          aria-hidden="true"
        />

        <span>
          Sortea el <time datetime={rifa.drawDate}
            >{shortDate(rifa.drawDate)}</time
          >
        </span>
      </span>

      <span class="shrink-0 text-support font-extrabold" data-numero>
        {pesos(rifa.ticketPrice)}<span
          class="text-label font-semibold text-subtle-foreground"
          >&nbsp;c/u</span
        >
      </span>
    </div>

    <Button
      href={`/panel/rifa/${rifa.id}`}
      variant={accion.variante}
      size="sm"
      class="mt-auto w-full"
      aria-label={`${accion.texto} ${rifa.title}`}
    >
      {accion.texto}
      {
        !cerrada && (
          <Icon
            name="lucide:arrow-right"
            class="size-4.75"
            aria-hidden="true"
          />
        )
      }
    </Button>
  </article>
</li>
