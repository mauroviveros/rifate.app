---
import type { RaffleListItem } from '@/types/raffle';
import { inDays } from '@/utils/format';
import { BADGE, estadoDe } from '@/utils/frontmatter/raffle';

interface Props {
  raffle: RaffleListItem;
  /** El día límite de «últimos días». Por defecto, dentro de 7 días.
      No es un `const` de módulo a propósito: un isolate de Workers vive horas
      y el valor se congelaría — se calcula por render. */
  limit?: string;
  class?: string;
}

const { raffle, limit = inDays(7), class: className } = Astro.props;
const badge = BADGE[estadoDe(raffle, limit)];
---

<span
  class:list={[
    'inline-block shrink-0 rounded-full px-2.5 py-1.5 text-label font-extrabold',
    badge.clase,
    className,
  ]}
>
  {badge.texto}
</span>
