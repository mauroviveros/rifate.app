---
import type { RaffleListItem } from '@/types/raffle';

import NewRaffleButton from './NewRaffleButton.astro';

interface Props {
  rifas: RaffleListItem[];
}

const { rifas } = Astro.props;

const enVenta = rifas.filter((r) => r.status === 'PUBLISHED').length;
const borradores = rifas.filter((r) => r.status === 'DRAFT').length;
const sorteadas = rifas.filter((r) => r.status === 'CLOSED').length;

/* «Tenés 2 rifas en venta y 1 ya sorteada.» Las partes en cero no se nombran:
   «0 ya sorteadas» es ruido, y con `Intl.ListFormat` el «y» de la última cae
   solo, con la coma en el medio cuando son tres. */
const partes = [
  enVenta > 0 && `${enVenta} ${enVenta === 1 ? 'rifa' : 'rifas'} en venta`,
  borradores > 0 && `${borradores} sin publicar`,
  sorteadas > 0 &&
    `${sorteadas} ya ${sorteadas === 1 ? 'sorteada' : 'sorteadas'}`,
].filter((parte) => typeof parte === 'string');

const lista = new Intl.ListFormat('es-AR', { type: 'conjunction' });
const bajada =
  partes.length > 0
    ? `Tenés ${lista.format(partes)}.`
    : 'Acá van a estar todas tus rifas.';
---

<header
  class:list={[
    'flex flex-col gap-6',
    'sm:flex-row sm:items-end sm:justify-between',
  ]}
>
  <hgroup>
    <h1 class="text-[2.25rem] sm:text-display">Mis rifas</h1>
    <p class="mt-2 text-support text-muted-foreground sm:text-body">
      {bajada}
    </p>
  </hgroup>

  {
    /* Con la pantalla vacía el CTA ya está en el medio, y dos acciones
      principales a la vez rompen la regla 2. */
  }
  {rifas.length > 0 && <NewRaffleButton class="hidden sm:flex" />}
</header>
