---
import { RafflePublicNumbers } from '@/components/raffle/public/RafflePublicNumbers';
import RafflePublicStats from '@/components/raffle/public/RafflePublicStats.astro';
import SocialMeta from '@/components/seo/SocialMeta.astro';
import PublicLayout from '@/layouts/PublicLayout.astro';
import { countSold, soldNumbersOf } from '@/lib/domain/raffle';
import { formatCurrency } from '@/lib/formatters';
import { getPublicRaffle } from '@/lib/repositories/raffle';
import { createServerClient } from '@/lib/supabase/server';

if (!Astro.params.id) return Astro.redirect('/');

const supabase = createServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const raffle = await getPublicRaffle(supabase, Astro.params.id);

if (!raffle) return Astro.rewrite('/404');

const soldNumbers = soldNumbersOf(raffle.numbers);
const soldCount = countSold(raffle.numbers);

const metaDescription =
  raffle.description?.trim() ||
  `Rifa de ${raffle.total_numbers} números a ${formatCurrency(raffle.price)} cada uno. Elegí tus números y contactá al organizador.`;
---

<PublicLayout title={raffle.title} description={metaDescription}>
  <SocialMeta
    slot="head"
    title={raffle.title}
    description={metaDescription}
    image={`/og/raffle/${raffle.id}.png`}
    path={`/raffle/${raffle.id}`}
  />

  <hgroup slot="header">
    <h1
      class="text-primary-foreground mb-1 text-2xl font-extrabold lg:text-3xl"
    >
      {raffle.title}
    </h1>
    <p class="text-primary-foreground/70 max-w-lg text-sm">
      {raffle.description}
    </p>
  </hgroup>

  <RafflePublicStats
    drawDate={raffle.draw_date}
    pricePerNumber={raffle.price}
    totalNumbers={raffle.total_numbers}
    availableNumbers={raffle.total_numbers - soldCount}
  />

  <RafflePublicNumbers
    client:load
    length={raffle.total_numbers}
    soldNumbers={soldNumbers}
    contactPhone={raffle.contact_phone}
    price={raffle.price}
    drawDate={raffle.draw_date}
  />
</PublicLayout>
