---
import Button from '@starwind/button';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@starwind/card';
import Progress from '@starwind/progress';
import Stats from '@ui/Stats.astro';
import { Icon } from 'astro-icon/components';

import AppLayout from '@/layouts/AppLayout.astro';
import {
  aggregateListStats,
  buildSalesDots,
  countSold,
} from '@/lib/domain/raffle';
import { formatCurrency, formatDate } from '@/lib/formatters';
import { mapRaffleListStats } from '@/lib/mappers';
import { listOwnerRaffles } from '@/lib/repositories/raffle';
import { createServerClient } from '@/lib/supabase/server';
import type { RaffleListItem } from '@/types';

const supabase = createServerClient({
  cookies: Astro.cookies,
  request: Astro.request,
});

let fetchError = false;
let raffles: RaffleListItem[] = [];

try {
  raffles = await listOwnerRaffles(supabase);
} catch {
  fetchError = true;
}

const STATS = mapRaffleListStats(aggregateListStats(raffles));

const enrichedRaffles = raffles.map((raffle) => ({
  ...raffle,
  soldCount: countSold(raffle.numbers),
  dots: buildSalesDots(raffle.numbers, raffle.total_numbers),
}));
---

<AppLayout size="5xl">
  <hgroup class="space-y-1" slot="header">
    <h1 class="text-2xl font-extrabold lg:text-3xl">Panel de rifas</h1>
    <p class="text-primary-foreground/70 text-sm">
      Gestioná y seguí el progreso de todas tus rifas
    </p>
  </hgroup>
  <Button
    slot="header"
    variant="secondary"
    size="sm"
    href="/dashboard/raffle/create"
  >
    <Icon name="lucide:plus" class="size-4" />
    <span class="font-bold">Crear rifa</span>
  </Button>

  <article class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
    {STATS.map((props) => <Stats {...props} />)}
  </article>

  {
    fetchError && (
      <Card size="sm" class="border-destructive/20 bg-destructive/10 mb-6">
        <CardContent class="flex items-center gap-3 py-6">
          <Icon
            name="lucide:alert-circle"
            class="text-destructive size-8 shrink-0"
          />
          <p class="text-destructive text-sm">
            No pudimos cargar tus rifas. Intentalo de nuevo más tarde.
          </p>
        </CardContent>
      </Card>
    )
  }

  {
    !fetchError && enrichedRaffles.length === 0 && (
      <Card size="sm" class="border-dashed">
        <CardContent class="flex flex-col items-center gap-4 py-12 text-center">
          <span class="bg-muted flex size-16 items-center justify-center rounded-2xl">
            <Icon name="lucide:ticket" class="text-muted-foreground size-8" />
          </span>
          <hgroup>
            <CardTitle class="text-foreground text-lg font-bold">
              Todavía no creaste ninguna rifa
            </CardTitle>
            <CardDescription class="text-muted-foreground mt-1 text-sm">
              Crea tu primera rifa y empezá a vender números al instante.
            </CardDescription>
          </hgroup>
          <Button variant="primary" href="/dashboard/raffle/create">
            <Icon name="lucide:plus" class="size-4" />
            <span class="font-bold">Crear mi primera rifa</span>
          </Button>
        </CardContent>
      </Card>
    )
  }

  {
    enrichedRaffles.length > 0 && (
      <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {enrichedRaffles.map(
          ({
            id,
            title,
            description,
            price,
            total_numbers,
            draw_date,
            soldCount,
            dots,
          }) => (
            <a href={`/dashboard/raffle/${id}`} class="group">
              <Card size="sm" class="shadow-card group-hover:shadow-card-hover">
                <CardHeader class="flex">
                  <hgroup class="min-w-0 flex-1">
                    <CardTitle class="group-hover:text-primary truncate font-bold transition-colors">
                      {title}
                    </CardTitle>
                    {description && (
                      <CardDescription class="text-muted-foreground line-clamp-1 text-xs!">
                        {description}
                      </CardDescription>
                    )}
                  </hgroup>
                </CardHeader>
                <CardContent>
                  <article class="mb-3 flex h-fit max-h-13 flex-wrap gap-0.5 overflow-hidden">
                    {dots.map((bool) => (
                      <span
                        class:list={[
                          'h-2 w-2 rounded-full',
                          bool ? 'bg-raffle-sold' : 'bg-primary/20',
                        ]}
                      />
                    ))}
                  </article>

                  <div class="mb-3 flex items-center justify-between">
                    <span class="text-muted-foreground text-sm font-medium">
                      {soldCount}/{total_numbers} vendidos
                    </span>
                    <span class="text-primary text-sm font-bold">
                      {Math.round((soldCount / total_numbers) * 100)}%
                    </span>
                  </div>

                  <Progress
                    value={Math.round((soldCount / total_numbers) * 100)}
                    variant="primary"
                    class="mb-4 h-1.5 rounded-full"
                  />

                  <div class="flex items-center justify-between border-t pt-3">
                    <span class="text-muted-foreground flex items-center gap-1 text-sm">
                      <Icon name="lucide:calendar-days" class="size-3.5" />
                      {formatDate(new Date(draw_date), {
                        day: '2-digit',
                        month: 'long',
                        year: 'numeric',
                      })}
                    </span>

                    <div class="flex items-center gap-1">
                      <Icon
                        name="lucide:dollar-sign"
                        class="text-accent size-3.5"
                      />
                      <span class="text-foreground font-extrabold">
                        {formatCurrency(price, false)}
                      </span>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </a>
          ),
        )}
      </section>
    )
  }
</AppLayout>
