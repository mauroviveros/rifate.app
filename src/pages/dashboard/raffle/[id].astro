---
import Button from '@starwind/button';
import { Icon } from 'astro-icon/components';

import { RaffleDetail } from '@/components/raffle/detail';
import RaffleDetailSkeleton from '@/components/raffle/detail/RaffleDetailSkeleton.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { getOwnerRaffle } from '@/lib/repositories/raffle';
import { createServerClient } from '@/lib/supabase/server';

if (!Astro.params.id) return Astro.redirect('/dashboard/raffle');

const user = Astro.locals.user;

if (!user) return Astro.redirect('/dashboard/raffle');

const supabase = createServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const raffle = await getOwnerRaffle(supabase, Astro.params.id, user.id);

if (!raffle) return Astro.redirect('/dashboard/raffle');
---

<AppLayout size="6xl">
  <hgroup slot="header">
    <h1
      class="text-primary-foreground mb-1 text-2xl font-extrabold lg:text-3xl"
    >
      {raffle.title}
    </h1>
    <p class="text-primary-foreground/70 max-w-lg text-sm">
      {raffle.description}
    </p>
  </hgroup>
  <div class="flex flex-wrap gap-2" slot="header" id="header-actions">
    <a href={`/raffle/${raffle.id}`} target="_blank" rel="noopener noreferrer">
      <Button variant="outline-primary" size="sm">
        <Icon name="lucide:link" />
        Link público
      </Button>
    </a>
  </div>

  <RaffleDetail raffle={raffle} client:only="react">
    <RaffleDetailSkeleton
      total_numbers={raffle.total_numbers}
      slot="fallback"
    />
  </RaffleDetail>
</AppLayout>
