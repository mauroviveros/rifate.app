---
import Button from '@starwind/button';
import { Icon } from 'astro-icon/components';

import { RaffleDetail } from '@/components/raffle/detail';
import RaffleDetailSkeleton from '@/components/raffle/detail/RaffleDetailSkeleton.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { createServerClient } from '@/lib/supabase/server';
import type { Tables } from '@/types';

if (!Astro.params.id) return Astro.redirect('/dashboard/raffle');

const user = Astro.locals.user;

if (!user) return Astro.redirect('/dashboard/raffle');

const supabase = createServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

type RaffleWithRelations = Tables<'raffles'> & {
  buyers: Tables<'raffle_buyers'>[];
  numbers: (Tables<'raffle_numbers'> & {
    buyer: Tables<'raffle_buyers'> | null;
  })[];
};

let raffle: RaffleWithRelations | null = null;

try {
  const { data } = await supabase
    .from('raffles')
    .select(
      `
      *,
      buyers:raffle_buyers(*),
      numbers:raffle_numbers(
        *,
        buyer:raffle_buyers(*)
      )
    `,
    )
    .eq('id', Astro.params.id)
    .single();

  raffle = data as RaffleWithRelations | null;
} catch {
  // fall through to redirect
}

if (!raffle || raffle.owner_id !== user.id) {
  return Astro.redirect('/dashboard/raffle');
}
---

<AppLayout size="6xl">
  <hgroup slot="header">
    <h1
      class="text-primary-foreground mb-1 text-2xl font-extrabold lg:text-3xl"
    >
      {raffle.title}
    </h1>
    <p class="text-primary-foreground/70 max-w-lg text-sm">
      {raffle.description}
    </p>
  </hgroup>
  <div class="flex flex-wrap gap-2" slot="header">
    <Button variant="outline-primary" size="sm" disabled>
      <Icon name="lucide:link" />
      Link público
    </Button>
  </div>

  <RaffleDetail raffle={raffle} client:only="react">
    <RaffleDetailSkeleton
      total_numbers={raffle.total_numbers}
      slot="fallback"
    />
  </RaffleDetail>
</AppLayout>
