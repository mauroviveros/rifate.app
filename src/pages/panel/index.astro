---
import Empty from '@/components/panel/Empty.astro';
import Header from '@/components/panel/Header.astro';
import MobileBar from '@/components/panel/MobileBar.astro';
import NewRaffle from '@/components/panel/NewRaffle.astro';
import Raffles from '@/components/panel/Raffles.astro';
import Stats from '@/components/panel/Stats.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { listOwnRaffles } from '@/lib/db';

const rifas = await listOwnRaffles(Astro.locals.actor);
---

<Dashboard title="Mis rifas · rifate.app">
  <Header rifas={rifas} />

  {
    rifas.length === 0 ? (
      <Empty />
    ) : (
      <>
        <Stats rifas={rifas} />
        <Raffles rifas={rifas} />
        <NewRaffle />
        <MobileBar />
      </>
    )
  }
</Dashboard>
