---
import Empty from '@/components/panel/list/Empty.astro';
import MobileBar from '@/components/panel/list/MobileBar.astro';
import NewRaffleBtn from '@/components/panel/list/NewRaffleBtn.astro';
import NewRaffleCTA from '@/components/panel/list/NewRaffleCTA.astro';
import Raffles from '@/components/panel/list/Raffles.astro';
import Stats from '@/components/panel/list/Stats.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { listOwnRaffles } from '@/lib/db';
import { flashMessage } from '@/utils/frontmatter/detail';
import { panelSummary } from '@/utils/frontmatter/panel';

const raffles = await listOwnRaffles(Astro.locals.actor);

/** Borrar una rifa vuelve acá (su detalle ya no existe), con el cartel. */
const okMessage = flashMessage(Astro.url.searchParams.get('ok'));
---

<Dashboard
  title="Mis rifas · rifate.app"
  heading="Mis rifas"
  lead={panelSummary(raffles)}
>
  {raffles.length > 0 && <NewRaffleBtn slot="actions" class="hidden sm:flex" />}

  {
    okMessage && (
      <p
        class="mt-6 rounded-lg bg-success/10 p-4 text-support font-bold text-success"
        role="status"
      >
        {okMessage}
      </p>
    )
  }

  {
    raffles.length === 0 ? (
      <Empty />
    ) : (
      <>
        <Stats raffles={raffles} />
        <Raffles raffles={raffles} />
        <NewRaffleCTA />
        <MobileBar />
      </>
    )
  }
</Dashboard>

<script>
  /* Mismo PRG que el detalle: el `?ok=` es de un solo uso. */
  if (location.search.includes('ok=')) {
    history.replaceState(null, '', location.pathname);
  }
</script>
