---
import { actions } from 'astro:actions';

import Form from '@/components/panel/create/Form.astro';
import Summary from '@/components/panel/create/Summary.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { formErrors } from '@/utils/action-result';

const result = Astro.getActionResult(actions.raffle.create);

/** Si la acción de crear la rifa fue exitosa, redirigir a la página de la rifa. */
if (result && !result.error) {
  return Astro.redirect(`/panel/rifa/${result.data.id}`, 303);
}

const { fields: errors, message: error } = formErrors(result);

/** Recuperar los datos del formulario si se ha enviado. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}
---

<Dashboard
  title="Crear una rifa · rifate.app"
  heading="Armemos tu rifa"
  lead="Son cinco datos. Abajo vas viendo cómo les va a quedar a tus compradores."
>
  <div
    class:list={[
      'mt-7 grid items-start gap-7 sm:mt-9',
      'lg:grid-cols-[1fr_380px] lg:gap-7.5',
    ]}
  >
    <Form
      action={actions.raffle.create}
      formData={formData}
      errors={errors}
      error={error}
      class="w-full"
    />
    <Summary formData={formData} />
  </div>
</Dashboard>
