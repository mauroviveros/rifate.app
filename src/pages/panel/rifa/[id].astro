---
import { actions, isInputError } from 'astro:actions';
import { Icon } from 'astro-icon/components';

import BackLink from '@/components/panel/BackLink.astro';
import Actions from '@/components/panel/detail/Actions.astro';
import BeforePublish from '@/components/panel/detail/BeforePublish.astro';
import BeforePublishBar from '@/components/panel/detail/BeforePublishBar.astro';
import Buyers from '@/components/panel/detail/Buyers.astro';
import DraftSummary from '@/components/panel/detail/DraftSummary.astro';
import EmptyGrid from '@/components/panel/detail/EmptyGrid.astro';
import Grid from '@/components/panel/detail/Grid.astro';
import Sale from '@/components/panel/detail/Sale.astro';
import SaleBar from '@/components/panel/detail/SaleBar.astro';
import Stats from '@/components/panel/detail/Stats.astro';
import WhenPublished from '@/components/panel/detail/WhenPublished.astro';
import StatusBadge from '@/components/panel/StatusBadge.astro';
import { Button } from '@/components/starwind/button';
import Dashboard from '@/layouts/Dashboard.astro';
import { ownerGrid } from '@/lib/raffles';
import { codeOf } from '@/utils/errors';
import { longDate } from '@/utils/format';
import { flashMessage, pendingBeforePublish } from '@/utils/frontmatter/detail';

const { id } = Astro.params;
if (!id) return Astro.rewrite('/404');

/**
 * PRG: las tres acciones del detalle redirigen con 303 en el éxito, así un F5
 * no reenvía el formulario. Mismo patrón que el alta.
 */
const publishResult = Astro.getActionResult(actions.raffle.publish);
const setPhoneResult = Astro.getActionResult(actions.raffle.setPhone);
const sellResult = Astro.getActionResult(actions.raffle.sell);
const releaseResult = Astro.getActionResult(actions.raffle.release);
const rebuildResult = Astro.getActionResult(actions.raffle.rebuildGrid);

if (publishResult && !publishResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=published`, 303);
}
if (setPhoneResult && !setPhoneResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=phone`, 303);
}
if (sellResult && !sellResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=sold-${sellResult.data.sold.length}`,
    303,
  );
}
if (releaseResult && !releaseResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=freed-${releaseResult.data.length}`,
    303,
  );
}
if (rebuildResult && !rebuildResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=rebuilt`, 303);
}

/**
 * `publish` y `setPhone` van los dos al mismo `<form>` de «Antes de publicar»,
 * así que su error —de campo o de dominio— se muestra ahí.
 */
const draftFormResult = publishResult ?? setPhoneResult;
let phoneErrors: string[] | undefined;
let phoneError: string | null = null;
if (draftFormResult?.error) {
  if (isInputError(draftFormResult.error)) {
    phoneErrors = draftFormResult.error.fields.contactPhone;
  } else {
    phoneError = draftFormResult.error.message;
  }
}

const saleResult = sellResult ?? releaseResult;
let saleErrors: Record<string, string[] | undefined> = {};
let saleError: string | null = null;
if (saleResult?.error) {
  if (isInputError(saleResult.error)) saleErrors = saleResult.error.fields;
  else saleError = saleResult.error.message;
}

const rebuildError = rebuildResult?.error?.message ?? null;

/**
 * Una rifa ajena y una inexistente se ven igual: un 404. Que exista o no es
 * justo el dato que no hay que filtrar — misma idea que `getOwnRaffle`.
 */
const loaded = await ownerGrid(Astro.locals.actor, id).catch(
  (error: unknown) => {
    const code = codeOf(error);
    if (code === 'NOT_FOUND' || code === 'FORBIDDEN') return null;
    throw error;
  },
);
if (!loaded) return Astro.rewrite('/404');
const { raffle, numbers } = loaded;

const publicUrl = new URL(
  `/r/${raffle.slug}`,
  Astro.site ?? 'https://rifate.app',
).href;

/** La bajada del canvas: la descripción y la fecha del sorteo en una línea. */
const drawVerb = raffle.status === 'CLOSED' ? 'sorteó' : 'sortea';
const drawLine = `se ${drawVerb} el ${longDate(raffle.drawDate)}`;
const subtitle = raffle.description
  ? `${raffle.description} · ${drawLine}`
  : drawLine.charAt(0).toUpperCase() + drawLine.slice(1);

/** Lo que se tipeó / eligió, para no perderlo tras un error de validación. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}
const selectedNumbers = (formData?.getAll('numbers') ?? [])
  .map((entry) => Number(entry))
  .filter((n) => Number.isInteger(n));

const phoneField = formData?.get('contactPhone');
const phoneValue = typeof phoneField === 'string' ? phoneField : '';

/**
 * El panel de venta vive sólo en `PUBLISHED`. En `DRAFT` lo reemplaza «Antes de
 * publicar»; en `CLOSED`/`CANCELLED` no hay nada que vender (fase 9).
 */
const isDraft = raffle.status === 'DRAFT';
const isPublished = raffle.status === 'PUBLISHED';
const pending = pendingBeforePublish(raffle);

/**
 * La grilla nunca es vacía en una rifa sana: el alta exige `totalNumbers >= 1`.
 * Si llega vacía es que `init()` del DO no corrió (ver `ownerGrid()` en
 * lib/raffles/flows.ts) — no hay nada que vender ni mostrar hasta rearmarla.
 */
const isEmpty = numbers.length === 0;

const okMessage = flashMessage(Astro.url.searchParams.get('ok'));
---

<Dashboard
  title={`${raffle.title} · rifate.app`}
  heading={raffle.title}
  description={subtitle}
  wideActions
>
  <BackLink slot="nav" />
  <StatusBadge slot="eyebrow" raffle={raffle} />

  <Actions
    slot="actions"
    raffle={raffle}
    publishAction={actions.raffle.publish}
    publicUrl={publicUrl}
  />

  {
    okMessage && (
      <p
        class="mt-6 rounded-lg bg-success/10 p-4 text-support font-bold text-success"
        role="status"
      >
        {okMessage}
      </p>
    )
  }

  {
    isDraft ? (
      <DraftSummary class="mt-7" raffle={raffle} pending={pending} />
    ) : (
      <Stats class="mt-7" numbers={numbers} ticketPrice={raffle.ticketPrice} />
    )
  }

  <div
    class:list={[
      'mt-7 grid gap-7',
      'lg:grid-cols-[1fr_380px] lg:items-start lg:gap-7.5',
    ]}
  >
    <div class="contents lg:flex lg:flex-col lg:gap-7">
      {
        isEmpty ? (
          <EmptyGrid
            raffleId={raffle.id}
            rebuildAction={actions.raffle.rebuildGrid}
            error={rebuildError}
          />
        ) : (
          <Grid
            numbers={numbers}
            numberStart={raffle.numberStart}
            totalNumbers={raffle.totalNumbers}
            selected={selectedNumbers}
            form={isPublished ? 'sale' : undefined}
            draft={isDraft}
          />
        )
      }

      {
        !isEmpty && (
          <Buyers
            class="order-2 lg:order-0"
            numbers={numbers}
            numberStart={raffle.numberStart}
            totalNumbers={raffle.totalNumbers}
          />
        )
      }
    </div>

    <div class="order-1 flex flex-col gap-6 lg:sticky lg:top-24 lg:order-0">
      {
        isDraft && (
          <>
            <BeforePublish
              raffle={raffle}
              publishAction={actions.raffle.publish}
              setPhoneAction={actions.raffle.setPhone}
              phoneErrors={phoneErrors}
              phoneError={phoneError}
              phoneValue={phoneValue}
            />
            <WhenPublished publicUrl={publicUrl} />
          </>
        )
      }

      {
        isPublished && !isEmpty && (
          <Sale
            id="sale"
            raffleId={raffle.id}
            ticketPrice={raffle.ticketPrice}
            sellAction={actions.raffle.sell}
            releaseAction={actions.raffle.release}
            formData={formData}
            errors={saleErrors}
            error={saleError}
          />
        )
      }

      {
        !isDraft && (
          <div class="rounded-xl border-2 border-dashed border-border p-6">
            <h2 class="text-[1.25rem] font-extrabold">Editar los datos</h2>
            <p class="mt-1 text-support text-subtle-foreground">
              Cambiá el título, el premio, la descripción o la fecha del sorteo.
            </p>
            <Button
              href={`/panel/rifa/${raffle.id}/editar`}
              variant="outline"
              size="md"
              class="mt-4 w-full"
            >
              <Icon name="lucide:pencil" aria-hidden="true" />
              Editar la rifa
            </Button>
          </div>
        )
      }
    </div>
  </div>

  {isPublished && !isEmpty && <SaleBar />}
  {isDraft && raffle.contactPhone === null && <BeforePublishBar />}
</Dashboard>

<script>
  /* El cartel de éxito viaja en `?ok=…` (PRG). Es de un solo uso: sacamos el
     parámetro para que un F5 no lo vuelva a mostrar. */
  if (location.search.includes('ok=')) {
    history.replaceState(null, '', location.pathname);
  }
</script>
