---
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';

import BackLink from '@/components/panel/BackLink.astro';
import Actions from '@/components/panel/detail/Actions.astro';
import BeforePublish from '@/components/panel/detail/BeforePublish.astro';
import Buyers from '@/components/panel/detail/buyers/Buyers.astro';
import DraftSummary from '@/components/panel/detail/DraftSummary.astro';
import EmptyGrid from '@/components/panel/detail/grid/EmptyGrid.astro';
import Grid from '@/components/panel/detail/grid/Grid.astro';
import Sale from '@/components/panel/detail/Sale.astro';
import Stats from '@/components/panel/detail/Stats.astro';
import WhenPublished from '@/components/panel/detail/WhenPublished.astro';
import StatusBadge from '@/components/panel/StatusBadge.astro';
import { Button } from '@/components/starwind/button';
import Dashboard from '@/layouts/Dashboard.astro';
import { ownerGrid } from '@/lib/raffles';
import { formErrors } from '@/utils/action-result';
import { codeOf } from '@/utils/errors';
import { detailView } from '@/utils/frontmatter/detail';

const { id } = Astro.params;
if (!id) return Astro.rewrite('/404');

const publishResult = Astro.getActionResult(actions.raffle.publish);
const setPhoneResult = Astro.getActionResult(actions.raffle.setPhone);
const sellResult = Astro.getActionResult(actions.raffle.sell);
const releaseResult = Astro.getActionResult(actions.raffle.release);
const rebuildResult = Astro.getActionResult(actions.raffle.rebuildGrid);

/**
 * PRG: las cinco acciones del detalle vuelven acá con un 303 en el éxito, así
 * un F5 no reenvía el formulario. Mismo patrón que el alta.
 *
 * ⚠️ El `Astro.redirect` va repetido y NO envuelto en un helper. Se probó:
 * cualquier `const done = …` / `function done()` que sólo se use desde estos
 * `return` sale reportado por `astro check` como «'done' is declared but its
 * value is never read» (ts 6133). El language server no ve los usos que están
 * después de un `return` en el frontmatter, y el `check` es parte del gate de
 * pre-push. Cinco líneas repetidas valen menos que un warning permanente.
 */
if (publishResult && !publishResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=published`, 303);
}
if (setPhoneResult && !setPhoneResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=phone`, 303);
}
if (sellResult && !sellResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=sold-${sellResult.data.sold.length}`,
    303,
  );
}
if (releaseResult && !releaseResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=freed-${releaseResult.data.length}`,
    303,
  );
}
if (rebuildResult && !rebuildResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=rebuilt`, 303);
}

/**
 * `publish` y `setPhone` comparten el `<form>` de «Antes de publicar», y `sell`
 * y `release` el del panel de venta: cada par muestra su error en un solo
 * lugar, sin importar cuál de los dos botones se apretó.
 */
const phone = formErrors(publishResult, setPhoneResult);
const sale = formErrors(sellResult, releaseResult);
const rebuild = formErrors(rebuildResult);

/**
 * Una rifa ajena y una inexistente se ven igual: un 404. Que exista o no es
 * justo el dato que no hay que filtrar — misma idea que `getOwnRaffle`.
 */
const loaded = await ownerGrid(Astro.locals.actor, id).catch(
  (error: unknown) => {
    const code = codeOf(error);
    if (code === 'NOT_FOUND' || code === 'FORBIDDEN') return null;
    throw error;
  },
);
if (!loaded) return Astro.rewrite('/404');
const { raffle, numbers } = loaded;

/** Lo que se tipeó / eligió, para no perderlo tras un error de validación. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}

/**
 * El resto lo deriva `detailView()`. El panel de venta, por ejemplo, vive sólo
 * en `PUBLISHED`: en `DRAFT` lo reemplaza «Antes de publicar», y en
 * `CLOSED`/`CANCELLED` no hay nada que vender (fase 9).
 */
const {
  subtitle,
  publicUrl,
  isDraft,
  isPublished,
  isEmpty,
  pending,
  okMessage,
  selectedNumbers,
  phoneValue,
} = detailView({
  raffle,
  numbers,
  formData,
  ok: Astro.url.searchParams.get('ok'),
  site: Astro.site,
});
---

<Dashboard
  title={`${raffle.title} · rifate.app`}
  heading={raffle.title}
  description={subtitle}
  wideActions
>
  <BackLink slot="nav" />
  <StatusBadge slot="eyebrow" raffle={raffle} />

  <Actions
    slot="actions"
    raffle={raffle}
    publishAction={actions.raffle.publish}
    publicUrl={publicUrl}
  />

  {
    okMessage && (
      <p
        class="mt-6 rounded-lg bg-success/10 p-4 text-support font-bold text-success"
        role="status"
      >
        {okMessage}
      </p>
    )
  }

  {
    isDraft ? (
      <DraftSummary class="mt-7" raffle={raffle} pending={pending} />
    ) : (
      <Stats class="mt-7" numbers={numbers} ticketPrice={raffle.ticketPrice} />
    )
  }

  <div
    class:list={[
      'mt-7 grid gap-7',
      'lg:grid-cols-[1fr_380px] lg:items-start lg:gap-7.5',
    ]}
  >
    <div class="contents lg:flex lg:flex-col lg:gap-7">
      {
        isEmpty ? (
          <EmptyGrid
            raffleId={raffle.id}
            rebuildAction={actions.raffle.rebuildGrid}
            error={rebuild.message}
          />
        ) : (
          <Grid
            numbers={numbers}
            numberStart={raffle.numberStart}
            totalNumbers={raffle.totalNumbers}
            selected={selectedNumbers}
            form={isPublished ? 'sale' : undefined}
            draft={isDraft}
          />
        )
      }

      {
        !isEmpty && (
          <Buyers
            class="order-2 lg:order-0"
            numbers={numbers}
            numberStart={raffle.numberStart}
            totalNumbers={raffle.totalNumbers}
          />
        )
      }
    </div>

    <div class="order-1 flex flex-col gap-6 lg:sticky lg:top-24 lg:order-0">
      {
        isDraft && (
          <>
            <BeforePublish
              raffle={raffle}
              publishAction={actions.raffle.publish}
              setPhoneAction={actions.raffle.setPhone}
              phoneErrors={phone.fields.contactPhone}
              phoneError={phone.message}
              phoneValue={phoneValue}
            />
            <WhenPublished publicUrl={publicUrl} />
          </>
        )
      }

      {
        isPublished && !isEmpty && (
          <Sale
            id="sale"
            raffleId={raffle.id}
            ticketPrice={raffle.ticketPrice}
            sellAction={actions.raffle.sell}
            releaseAction={actions.raffle.release}
            formData={formData}
            errors={sale.fields}
            error={sale.message}
          />
        )
      }

      {
        !isDraft && (
          <div class="rounded-xl border-2 border-dashed border-border p-6">
            <h2 class="text-[1.25rem] font-extrabold">Editar los datos</h2>
            <p class="mt-1 text-support text-subtle-foreground">
              Cambiá el título, el premio, la descripción o la fecha del sorteo.
            </p>
            <Button
              href={`/panel/rifa/${raffle.id}/editar`}
              variant="outline"
              size="md"
              class="mt-4 w-full"
            >
              <Icon name="lucide:pencil" aria-hidden="true" />
              Editar la rifa
            </Button>
          </div>
        )
      }
    </div>
  </div>

  {
    /* Reserva el alto de la barra fija que montan `Sale` y `BeforePublish` en
       mobile, para que el último bloque no quede tapado. Es lo único de esas
       barras que vive acá: tiene que ser el último elemento del flujo, y la
       columna lateral —donde viven los dos paneles— va ANTES de la lista de
       compradores en mobile. */
  }
  {isPublished && !isEmpty && <div class="h-20 lg:hidden" aria-hidden="true" />}
  {
    isDraft && raffle.contactPhone === null && (
      <div class="h-24 lg:hidden" aria-hidden="true" />
    )
  }
</Dashboard>

<script>
  /* El cartel de éxito viaja en `?ok=…` (PRG). Es de un solo uso: sacamos el
     parámetro para que un F5 no lo vuelva a mostrar. */
  if (location.search.includes('ok=')) {
    history.replaceState(null, '', location.pathname);
  }
</script>
