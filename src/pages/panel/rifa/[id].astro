---
import { actions, isInputError } from 'astro:actions';
import { Icon } from 'astro-icon/components';

import BackLink from '@/components/panel/BackLink.astro';
import Actions from '@/components/panel/detail/Actions.astro';
import Buyers from '@/components/panel/detail/Buyers.astro';
import Grid from '@/components/panel/detail/Grid.astro';
import Sale from '@/components/panel/detail/Sale.astro';
import SaleBar from '@/components/panel/detail/SaleBar.astro';
import Stats from '@/components/panel/detail/Stats.astro';
import StatusBadge from '@/components/panel/StatusBadge.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { ownerGrid } from '@/lib/raffles';
import { codeOf } from '@/utils/errors';
import { longDate } from '@/utils/format';
import { flashMessage } from '@/utils/frontmatter/detail';

const { id } = Astro.params;
if (!id) return Astro.rewrite('/404');

/**
 * PRG: las tres acciones del detalle redirigen con 303 en el éxito, así un F5
 * no reenvía el formulario. Mismo patrón que el alta.
 */
const publishResult = Astro.getActionResult(actions.raffle.publish);
const sellResult = Astro.getActionResult(actions.raffle.sell);
const releaseResult = Astro.getActionResult(actions.raffle.release);

if (publishResult && !publishResult.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=published`, 303);
}
if (sellResult && !sellResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=sold-${sellResult.data.sold.length}`,
    303,
  );
}
if (releaseResult && !releaseResult.error) {
  return Astro.redirect(
    `/panel/rifa/${id}?ok=freed-${releaseResult.data.length}`,
    303,
  );
}

/** publish → el `actions` del encabezado. sell/release → el panel `Sale`. */
const publishError =
  publishResult?.error && !isInputError(publishResult.error)
    ? publishResult.error.message
    : null;

const saleResult = sellResult ?? releaseResult;
let saleErrors: Record<string, string[] | undefined> = {};
let saleError: string | null = null;
if (saleResult?.error) {
  if (isInputError(saleResult.error)) saleErrors = saleResult.error.fields;
  else saleError = saleResult.error.message;
}

/**
 * Una rifa ajena y una inexistente se ven igual: un 404. Que exista o no es
 * justo el dato que no hay que filtrar — misma idea que `getOwnRaffle`.
 */
const loaded = await ownerGrid(Astro.locals.actor, id).catch(
  (error: unknown) => {
    const code = codeOf(error);
    if (code === 'NOT_FOUND' || code === 'FORBIDDEN') return null;
    throw error;
  },
);
if (!loaded) return Astro.rewrite('/404');
const { raffle, numbers } = loaded;

const publicUrl = new URL(
  `/r/${raffle.slug}`,
  Astro.site ?? 'https://rifate.app',
).href;

/** La bajada del canvas: la descripción y la fecha del sorteo en una línea. */
const drawVerb = raffle.status === 'CLOSED' ? 'sorteó' : 'sortea';
const drawLine = `se ${drawVerb} el ${longDate(raffle.drawDate)}`;
const subtitle = raffle.description
  ? `${raffle.description} · ${drawLine}`
  : drawLine.charAt(0).toUpperCase() + drawLine.slice(1);

/** Lo que se tipeó / eligió, para no perderlo tras un error de validación. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}
const selectedNumbers = (formData?.getAll('numbers') ?? [])
  .map((entry) => Number(entry))
  .filter((n) => Number.isInteger(n));

const okMessage = flashMessage(Astro.url.searchParams.get('ok'));
---

<Dashboard
  title={`${raffle.title} · rifate.app`}
  heading={raffle.title}
  description={subtitle}
  wideActions
>
  <BackLink slot="nav" />
  <StatusBadge slot="eyebrow" raffle={raffle} />

  <Actions
    slot="actions"
    raffle={raffle}
    publishAction={actions.raffle.publish}
    publicUrl={publicUrl}
  />

  {
    okMessage && (
      <p
        class="mt-6 rounded-lg bg-success/10 p-4 text-support font-bold text-success"
        role="status"
      >
        {okMessage}
      </p>
    )
  }

  {
    publishError && (
      <p
        class="mt-6 flex items-start gap-2.5 rounded-lg bg-error/8 p-4 text-support font-bold text-error"
        role="alert"
      >
        <Icon name="lucide:circle-alert" class="mt-0.5 size-5.5 shrink-0" />
        <span>{publishError}</span>
      </p>
    )
  }

  <Stats class="mt-7" numbers={numbers} ticketPrice={raffle.ticketPrice} />

  <div
    class:list={[
      'mt-7 grid gap-7',
      'lg:grid-cols-[1fr_380px] lg:items-start lg:gap-7.5',
    ]}
  >
    <Grid
      numbers={numbers}
      numberStart={raffle.numberStart}
      totalNumbers={raffle.totalNumbers}
      selected={selectedNumbers}
      form="sale"
    />

    <Sale
      id="sale"
      class="lg:sticky lg:top-24 lg:row-span-2"
      raffleId={raffle.id}
      ticketPrice={raffle.ticketPrice}
      sellAction={actions.raffle.sell}
      releaseAction={actions.raffle.release}
      formData={formData}
      errors={saleErrors}
      error={saleError}
    />

    <Buyers
      numbers={numbers}
      numberStart={raffle.numberStart}
      totalNumbers={raffle.totalNumbers}
    />
  </div>

  <SaleBar formId="sale" />
</Dashboard>

<script>
  /* El cartel de éxito viaja en `?ok=…` (PRG). Es de un solo uso: sacamos el
     parámetro para que un F5 no lo vuelva a mostrar. */
  if (location.search.includes('ok=')) {
    history.replaceState(null, '', location.pathname);
  }
</script>
