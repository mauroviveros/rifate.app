---
import { actions } from 'astro:actions';

import BackLink from '@/components/panel/BackLink.astro';
import Form from '@/components/panel/create/Form.astro';
import Summary from '@/components/panel/create/Summary.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { getOwnRaffle } from '@/lib/db';
import { formErrors } from '@/utils/action-result';
import { codeOf } from '@/utils/errors';
import { toEditInitial } from '@/utils/frontmatter/detail';

const { id } = Astro.params;
if (!id) return Astro.rewrite('/404');

/** PRG: en el éxito se vuelve al detalle con el flash. Mismo patrón que el alta. */
const result = Astro.getActionResult(actions.raffle.update);
if (result && !result.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=updated`, 303);
}

const { fields: errors, message: error } = formErrors(result);

/**
 * Una rifa ajena y una inexistente se ven igual: un 404. Misma idea que
 * `getOwnRaffle` y que `[id].astro`.
 */
const raffle = await getOwnRaffle(Astro.locals.actor, id).catch(
  (e: unknown) => {
    const code = codeOf(e);
    if (code === 'NOT_FOUND' || code === 'FORBIDDEN') return null;
    throw e;
  },
);
if (!raffle) return Astro.rewrite('/404');

/**
 * Con la rifa fuera de DRAFT, el precio y la cantidad quedan bloqueados:
 * cambiarlos le movería el trato a quien ya compró y desincronizaría D1 con el
 * DO. El flujo `updateRaffleDetails` lo aplica igual; acá es sólo la pantalla.
 */
const lockRange = raffle.status !== 'DRAFT';
const initial = toEditInitial(raffle);

/** Lo que se tipeó, para no perderlo tras un error de validación. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}
---

<Dashboard
  title={`Editar ${raffle.title} · rifate.app`}
  heading="Editá tu rifa"
  description="Cambiá lo que haga falta. Se ve al instante en tu link."
>
  <BackLink slot="nav" href={`/panel/rifa/${id}`} label="Volver a la rifa" />

  <div
    class:list={[
      'mt-7 grid items-start gap-7 sm:mt-9',
      'lg:grid-cols-[1fr_380px] lg:gap-7.5',
    ]}
  >
    <Form
      mode="edit"
      raffleId={id}
      action={actions.raffle.update}
      initial={initial}
      lockRange={lockRange}
      formData={formData}
      errors={errors}
      error={error}
      class="w-full"
    />
    <Summary formData={formData} initial={initial} />
  </div>
</Dashboard>
