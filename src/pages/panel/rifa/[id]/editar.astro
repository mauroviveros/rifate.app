---
/**
 * Editar una rifa.
 *
 * Es el alta con otros valores: el mismo `Form` y el mismo `Summary`, en modo
 * `edit`. Lo único propio de esta pantalla es de dónde salen los valores
 * iniciales —`toEditInitial(raffle)`— y el candado del rango.
 */
import { actions } from 'astro:actions';

import Form from '@/components/panel/create/Form.astro';
import Summary from '@/components/panel/create/Summary.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import { getOwnRaffle } from '@/lib/db';
import { formErrors } from '@/utils/action-result';
import { codeOf } from '@/utils/errors';
import { toEditInitial } from '@/utils/frontmatter/detail';

const { id } = Astro.params;
if (!id) return Astro.rewrite('/404');

/** PRG: en el éxito se vuelve al detalle con el flash. Mismo patrón que el alta. */
const result = Astro.getActionResult(actions.raffle.update);
if (result && !result.error) {
  return Astro.redirect(`/panel/rifa/${id}?ok=updated`, 303);
}

const { fields: errors, message: error } = formErrors(result);

/**
 * Una rifa ajena y una inexistente se ven igual: un 404. Que exista o no es
 * justo el dato que no hay que filtrar — misma idea que el detalle.
 */
const raffle = await getOwnRaffle(Astro.locals.actor, id).catch(
  (raised: unknown) => {
    const code = codeOf(raised);
    if (code === 'NOT_FOUND' || code === 'FORBIDDEN') return null;
    throw raised;
  },
);
if (!raffle) return Astro.rewrite('/404');

/**
 * Fuera de DRAFT el precio, la cantidad y el arranque quedan bloqueados:
 * cambiarlos le movería el trato a quien ya compró, y en DRAFT obligan a
 * rehacer la grilla del Durable Object.
 *
 * `updateRaffleDetails` ya ignora el rango fuera de DRAFT venga como venga —
 * esto es la pantalla diciéndolo antes, no la regla. La regla vive en el flujo.
 */
const lockRange = raffle.status !== 'DRAFT';
const initial = toEditInitial(raffle);

/** Lo que se tipeó, para no perderlo tras un error de validación. */
let formData: FormData | null = null;
if (Astro.request.method === 'POST') {
  try {
    formData = await Astro.request.clone().formData();
  } catch {
    formData = null;
  }
}
---

<Dashboard
  title={`Editar ${raffle.title} · rifate.app`}
  heading="Editá tu rifa"
  lead="Cambiá lo que haga falta. Se ve al instante en tu link."
>
  <div
    class:list={[
      'mt-7 grid items-start gap-7 sm:mt-9',
      'lg:grid-cols-[1fr_380px] lg:gap-7.5',
    ]}
  >
    <Form
      mode="edit"
      raffleId={id}
      action={actions.raffle.update}
      initial={initial}
      lockRange={lockRange}
      formData={formData}
      errors={errors}
      error={error}
      class="w-full"
    />
    <Summary formData={formData} initial={initial} />
  </div>
</Dashboard>
