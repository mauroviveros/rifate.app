---
import Base from '@/layouts/Base.astro';

// La landing de verdad es la fase 7. Esto es un puente honesto, no la pantalla
// final: lo único que tiene que hacer hoy es llevarte adentro.
const entrado = Astro.locals.actor.kind !== 'visitor';
---

<Base
  title="rifate.app · vendé tu rifa por WhatsApp"
  description="Armá la rifa, compartí el link y llevá la cuenta sin cuaderno."
>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-5">
    <p class="font-display text-title font-extrabold tracking-tight">
      rifate<span class="text-vermilion">.app</span>
    </p>

    <h1 class="mt-6 text-display leading-none">
      Tu talonario,<br />sin el cuaderno.
    </h1>

    <p class="mt-4 max-w-lg text-body text-muted-foreground">
      Armás la rifa, compartís el link por WhatsApp y la app lleva la cuenta de
      quién tiene cada número.
    </p>

    <a
      href={entrado ? '/dashboard/raffle' : '/login'}
      class="mt-8 grid h-button w-full max-w-xs place-items-center rounded-cell bg-vermilion text-body font-bold text-primary-foreground"
    >
      {entrado ? 'Ir a mis rifas' : 'Empezar'}
    </a>
  </main>
</Base>
