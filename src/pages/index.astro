---
import CTA from '@/components/landing/CTA.astro';
import FAQs from '@/components/landing/FAQs.astro';
import Hero from '@/components/landing/Hero.astro';
import HowItWorks from '@/components/landing/HowItWorks.astro';
import Marketing from '@/layouts/Marketing.astro';

export const prerender = true;

const title = 'rifate.app · rifas de barrio por WhatsApp';
