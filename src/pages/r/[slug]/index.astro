---
import { Icon } from 'astro-icon/components';

import Meter from '@/components/panel/Meter.astro';
import Stat from '@/components/panel/Stat.astro';
import Cell from '@/components/raffle/Cell.astro';
import { Button } from '@/components/starwind/button';
import Public from '@/layouts/Public.astro';
import { publicGrid } from '@/lib/raffles';
import { pesos, shortDate } from '@/utils/format';
import { publicUrlOf } from '@/utils/frontmatter/detail';
import { numberLabel, numberWidth } from '@/utils/frontmatter/numbers';
import { soldSummary } from '@/utils/live';
import { localPhone, waLink } from '@/utils/whatsapp';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/404');

/**
 * Un slug inexistente y un borrador ajeno se ven igual: un 404. La regla de
 * quién ve qué vive en `getPublicRaffleBySlug`.
 */
const loaded = await publicGrid(Astro.locals.actor, slug);
if (!loaded) return Astro.rewrite('/404');
const { raffle, numbers } = loaded;

/**
 * Sólo lo que ve todo el mundo se cachea. El borrador (o la cancelada) que
 * previsualiza su dueño es una respuesta que depende de la sesión: si un caché
 * compartido la guardara, se la serviría al próximo que pida el link.
 */
const isPublic = raffle.status === 'PUBLISHED' || raffle.status === 'CLOSED';
Astro.response.headers.set(
  'Cache-Control',
  isPublic
    ? 'public, s-maxage=30, stale-while-revalidate=300'
    : 'private, no-store',
);

/**
 * Sólo se escucha lo que puede cambiar. En un borrador no se vende y una rifa
 * cerrada ya no se mueve: abrir un WebSocket ahí sería una conexión de más
 * mirando algo quieto.
 */
const isLive = raffle.status === 'PUBLISHED';

// Se cuenta sobre la grilla y no sobre `raffle.soldCount`: la fila de D1 es el
// caché y el DO es la verdad (mismo criterio que `tally`). Es la misma cuenta
// que hace el `<script>` con cada grilla que llega en vivo.
const avance = soldSummary(numbers);
const width = numberWidth(raffle.numberStart, raffle.totalNumbers);

/**
 * La compra de una rifa BASIC: un WhatsApp al organizador con el link de la
 * rifa adentro, para que sepa de cuál le hablan. En una rifa cerrada ya no hay
 * nada que comprar.
 */
const contact =
  raffle.status !== 'CLOSED' && raffle.contactPhone !== null
    ? {
        url: waLink(
          raffle.contactPhone,
          `¡Hola! Quiero números de «${raffle.title}» 👉 ${publicUrlOf(raffle, Astro.site)}`,
        ),
        phone: localPhone(raffle.contactPhone),
      }
    : null;

/**
 * La bajada de la vista previa en WhatsApp: lo que la imagen fija no puede
 * decir de ESTA rifa. El premio primero, porque es lo que hace tocar el link.
 */
const summary = [
  raffle.prize && `Premio: ${raffle.prize}`,
  `Cada número ${pesos(raffle.ticketPrice)}`,
  `Sortea el ${shortDate(raffle.drawDate)}`,
]
  .filter(Boolean)
  .join(' · ');
---

<Public title={`${raffle.title} · rifate.app`} description={summary}>
  {
    !isPublic && (
      <p class="mb-6 rounded-lg bg-warning px-5 py-4 text-support font-bold text-foreground">
        Borrador · Así la va a ver la gente cuando la publiques. Por ahora sólo
        la ves vos.
      </p>
    )
  }

  <hgroup>
    <h1 class="text-[2.25rem] text-balance sm:text-display">{raffle.title}</h1>
    {
      raffle.prize && (
        <p class="mt-2 text-body font-bold text-foreground">
          Premio: {raffle.prize}
        </p>
      )
    }
    {
      raffle.description && (
        <p class="mt-2 text-body text-pretty text-muted-foreground">
          {raffle.description}
        </p>
      )
    }
  </hgroup>

  <!-- TODO: Mostrar el ganador -->
  {
    raffle.status === 'CLOSED' && raffle.winnerNumber !== null && (
      <p class="mt-6 rounded-lg bg-foreground px-5 py-4 text-body font-extrabold text-background">
        Ganó el número{' '}
        <span class="text-warning" data-numero>
          {numberLabel(raffle.winnerNumber, width)}
        </span>
        {raffle.winnerName && <> · {raffle.winnerName}</>}
      </p>
    )
  }

  <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-3">
    <Stat label="Cada número">{pesos(raffle.ticketPrice)}</Stat>
    <Stat label="Sortea el">{shortDate(raffle.drawDate)}</Stat>
    <Meter
      label={avance.label}
      value={avance.value}
      class="col-span-2 sm:col-span-1"
    />
  </dl>

  {
    contact && (
      <div class="mt-7 flex flex-col items-center gap-2 sm:items-start">
        <Button
          href={contact.url}
          variant="primary"
          size="lg"
          target="_blank"
          rel="noopener"
          class="w-full sm:w-auto"
        >
          <Icon name="lucide:message-circle" aria-hidden="true" />
          Pedir números por WhatsApp
        </Button>
        <p class="text-label text-subtle-foreground">
          o escribile al <span data-numero>{contact.phone}</span>
        </p>
      </div>
    )
  }

  <section
    class="mt-7 rounded-xl bg-card p-4 ring-2 ring-border sm:p-6"
    aria-labelledby="grid-title"
    data-live={isLive ? `/r/${raffle.slug}/live` : undefined}
  >
    <h2 id="grid-title" class="text-[1.25rem]">Los números</h2>
    <p class="mt-0.5 text-label text-subtle-foreground">
      Los tachados ya se vendieron.
    </p>

    {
      numbers.length > 0 ? (
        <div
          class="mt-4 grid grid-cols-5 gap-1.5 sm:grid-cols-10 sm:gap-1"
          role="group"
          aria-label="Números de la rifa"
        >
          {numbers.map(({ number, status }) => (
            <Cell value={number} status={status} width={width} />
          ))}
        </div>
      ) : (
        <p class="mt-4 text-support text-muted-foreground">
          La grilla todavía no está lista. Probá de nuevo en un rato.
        </p>
      )
    }
  </section>
</Public>

<script>
  // Directo del módulo y no de un barril: esto va al bundle del navegador.
  import type { PublicNumber } from '@/types/raffle';
  import { isTaken, liveGrid, soldSummary } from '@/utils/live';

  const $grid = document.querySelector<HTMLElement>('[data-live]');

  if ($grid?.dataset.live) {
    const $cells = new Map(
      Array.from($grid.querySelectorAll<HTMLElement>('[data-number]'), ($c) => [
        Number($c.dataset.number),
        $c,
      ]),
    );
    const $label = document.querySelector('[data-meter-label]');
    const $bar = document.querySelector<HTMLElement>('[data-meter-bar]');
    const $value = document.querySelector('[data-meter-value]');

    /** Repinta los números y el avance con la grilla que mandó el DO. */
    const paint = (numbers: PublicNumber[]) => {
      for (const { number, status } of numbers) {
        $cells.get(number)?.toggleAttribute('data-taken', isTaken(status));
      }

      const { label, value } = soldSummary(numbers);
      if ($label) $label.textContent = label;
      if ($bar) $bar.style.width = `${value}%`;
      if ($value) $value.textContent = `${value}%`;
    };

    const url = new URL($grid.dataset.live, location.href);
    url.protocol = url.protocol === 'https:' ? 'wss:' : 'ws:';

    const live = liveGrid({ url: url.href, onGrid: paint });

    // Con la pestaña oculta no hay nadie mirando: se corta, y al volver se
    // reconecta y la grilla de entrada la pone al día.
    const sync = () =>
      document.visibilityState === 'visible' ? live.start() : live.stop();

    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>
