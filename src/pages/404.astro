---
import { Icon } from 'astro-icon/components';

import { Button } from '@/components/starwind/button';
import Base from '@/layouts/Base.astro';

const fila = [40, 41, 404, 43, 44];
---

<Base
  title="Ese número no existe · rifate.app"
  description="La página que buscabas no está o la rifa ya se dio de baja."
>
  <main class="grid min-h-dvh place-items-center trama px-5 py-10">
    <div class="w-full max-w-lg text-center">
      <ul class="mx-auto flex w-fit gap-2" aria-hidden="true">
        {
          fila.map((numero) => (
            <li
              class:list={[
                'grid size-14 place-items-center rounded-sm border-2 font-extrabold',
                numero === 404
                  ? 'border-primary bg-primary text-primary-foreground'
                  : 'border-border bg-muted tachado text-disabled-foreground',
              ]}
              data-numero
            >
              {numero}
            </li>
          ))
        }
      </ul>

      <h1 class="mt-8 text-display">Ese número no existe</h1>

      <p class="mt-3 text-muted-foreground">
        La página que buscabas no está o la rifa ya se dio de baja. Fijate que
        el link esté completo, o pedile a quien te lo pasó que lo mande de
        nuevo.
      </p>

      <!-- En el celular los dos botones no entran uno al lado del otro sin
           romper el piso de 56px de alto y 18px de texto: se apilan. -->
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" variant="primary">
          <Icon name="lucide:house" />
          Ir al inicio
        </Button>
        <Button href="/panel" variant="outline">Ver mis rifas</Button>
      </div>
    </div>
  </main>
</Base>
