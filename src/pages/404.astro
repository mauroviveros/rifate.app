---
import Button from '@starwind/button';
import { Card, CardContent } from '@starwind/card';
import { Icon } from 'astro-icon/components';

import Layout from '@/layouts/Layout.astro';
---

<Layout
  class="mx-auto flex h-dvh w-full max-w-md items-center justify-center p-4"
>
  <Card class="border-dashed text-center">
    <CardContent class="flex flex-col items-center gap-4 py-12">
      <span
        class="bg-muted flex size-16 items-center justify-center rounded-2xl"
      >
        <Icon name="lucide:search-x" class="text-muted-foreground size-8" />
      </span>
      <hgroup>
        <h1 class="text-foreground text-lg font-bold">Página no encontrada</h1>
        <p class="text-muted-foreground mt-1 text-sm">
          La página que buscás no existe o fue eliminada.
        </p>
      </hgroup>
      <Button variant="primary" href="/dashboard/raffle">
        <Icon name="lucide:home" class="size-4" />
        <span class="font-bold">Volver al inicio</span>
      </Button>
    </CardContent>
  </Card>
</Layout>
